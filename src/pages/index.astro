  <script is:inline>
    (() => {
      const productionHosts = new Set([
        "buildwisemedia.com",
        "www.buildwisemedia.com",
        "bwm-new-website-review.pages.dev",
      ]);
      const attributionKey = "_bwm_attribution";
      const keys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid", "fbclid"];
      const params = new URLSearchParams(window.location.search);
      const current = {};
      keys.forEach((key) => {
        const value = params.get(key);
        if (value) current[key] = value.slice(0, 1000);
      });

      try {
        const prior = JSON.parse(localStorage.getItem(attributionKey) || "null");
        const now = new Date().toISOString();
        const record = prior && typeof prior === "object"
          ? prior
          : { first_touch: { ts: now, referrer: document.referrer || null, landing_page: window.location.href, utm: current }, last_touch: null };
        record.last_touch = { ts: now, referrer: document.referrer || null, landing_page: window.location.href, utm: current };
        localStorage.setItem(attributionKey, JSON.stringify(record));
        if (!sessionStorage.getItem("bwm_landing_page")) sessionStorage.setItem("bwm_landing_page", window.location.href);
        if (!sessionStorage.getItem("bwm_referrer")) sessionStorage.setItem("bwm_referrer", document.referrer || "");

        const forwarded = { ...(record.first_touch?.utm || {}), ...(record.last_touch?.utm || {}), ...current };
        const forwardAttribution = () => {
          document.querySelectorAll('a[href="/book/"]').forEach((link) => {
            const destination = new URL(link.href, window.location.origin);
            keys.forEach((key) => {
              if (forwarded[key]) destination.searchParams.set(key, forwarded[key]);
            });
            link.href = `${destination.pathname}${destination.search}`;
          });
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", forwardAttribution, { once: true });
        } else {
          forwardAttribution();
        }
      } catch { /* Attribution storage is optional; the page remains usable without it. */ }

      if (!productionHosts.has(window.location.hostname)) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("config", "G-V5LSP69E41", { send_page_view: true });

      const appendScript = (src) => {
        const script = document.createElement("script");
        script.async = true;
        script.src = src;
        document.head.appendChild(script);
        return script;
      };
      const gtagScript = appendScript("https://www.googletagmanager.com/gtag/js?id=G-V5LSP69E41");
      const loadContainer = () => {
        window.dataLayer.push({ "gtm.start": Date.now(), event: "gtm.js" });
        appendScript("https://www.googletagmanager.com/gtm.js?id=GTM-P5JSD86L");
      };
      gtagScript.addEventListener("load", loadContainer, { once: true });
      gtagScript.addEventListener("error", loadContainer, { once: true });

      const gtagReady = () => Boolean(window.google_tag_manager?.["G-V5LSP69E41"]);
      const sendFastClickBeacon = (source) => {
        if (typeof navigator.sendBeacon !== "function") return;
        try {
          const match = document.cookie.match(/(?:^|; )_ga=GA\d+\.\d+\.([^;]+)/);
          const clientId = match?.[1] || `${Math.floor(Math.random() * 1e9)}.${Math.floor(Date.now() / 1000)}`;
          const query = new URLSearchParams({
            v: "2",
            tid: "G-V5LSP69E41",
            cid: clientId,
            en: "fit_cta_click",
            "ep.cta_source": source
          });
          navigator.sendBeacon(`https://www.google-analytics.com/g/collect?${query.toString()}`);
        } catch { /* Analytics failure must never block navigation. */ }
      };

      document.addEventListener("click", (event) => {
        const link = event.target.closest?.('a[href^="/book/"]');
        if (!link) return;
        const source = link.dataset.ctaSource || "unspecified";
        if (gtagReady()) {
          window.gtag("event", "fit_cta_click", {
            cta_source: source,
            transport_type: "beacon"
          });
        } else {
          sendFastClickBeacon(source);
        }
      }, true);
    })();
  </script>
