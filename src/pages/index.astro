  <style>
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url("/fonts/inter-variable-v1.woff2") format("woff2-variations");
    }

    :root {
      color-scheme: light;
      --ink: #101217;
      --paper: #f4f3ee;
      --white: #ffffff;
      --muted: #656b76;
      --line: #d7d6cf;
      --yellow: #f0ff00;
      --blue: #304bd6;
      --blue-bright: #6f84ff;
      --orange: #ff6847;
      --orange-ink: #d94b20;
      --mint: #27b899;
      --night: #0c1017;
      --night-2: #141a24;
      --night-3: #202838;
      --max: 1280px;
      --gutter: clamp(20px, 4vw, 64px);
      --display-section: clamp(3.2rem, 6vw, 6rem);
      --display-supporting: clamp(2.9rem, 5vw, 5rem);
      --display-decision: clamp(4rem, 8vw, 8rem);
    }

    * { box-sizing: border-box; }

    html {
      background: var(--paper);
      scroll-behavior: smooth;
      scroll-padding-top: 92px;
    }

    body {
      background: var(--paper);
      color: var(--ink);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 1.125rem;
      margin: 0;
      overflow-x: hidden;
    }

    p,
    li { text-wrap: pretty; }

    button,
    a { font: inherit; }

    a { color: inherit; }

    :focus-visible {
      outline: 3px solid var(--blue);
      outline-offset: 4px;
    }

    .skip-link {
      background: var(--yellow);
      color: var(--ink);
      left: 16px;
      padding: 10px 14px;
      position: fixed;
      top: -80px;
      z-index: 100;
    }

    .skip-link:focus { top: 16px; }

    .sr-only {
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      height: 1px;
      overflow: hidden;
      position: absolute;
      white-space: nowrap;
      width: 1px;
    }

    .site-nav {
      align-items: center;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      min-height: 78px;
      padding: 14px 0;
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .nav-inner {
      align-items: center;
      display: flex;
      justify-content: space-between;
      margin: 0 auto;
      max-width: var(--max);
      padding-left: var(--gutter);
      padding-right: var(--gutter);
      width: 100%;
    }

    .brand {
      align-items: center;
      display: inline-flex;
      gap: 12px;
      text-decoration: none;
    }

    .brand img {
      background: var(--night);
      border-radius: 12px;
      display: block;
      flex: 0 0 auto;
      height: 48px;
      object-fit: contain;
      padding: 5px;
      width: 48px;
    }

    .brand span {
      font-size: 0.9rem;
      font-weight: 760;
      letter-spacing: -0.02em;
    }

    .nav-links {
      align-items: center;
      display: flex;
      gap: clamp(18px, 3vw, 36px);
    }

    .mobile-jumps { display: none; }

    .nav-links a {
      align-items: center;
      color: #4e545e;
      display: inline-flex;
      font-size: 0.84rem;
      min-height: 24px;
      text-decoration: none;
    }

    .nav-links a:hover { color: var(--ink); }

    .nav-links .cta { color: var(--white); }
    .nav-links .cta:hover { color: var(--ink); }

    .cta {
      align-items: center;
      background: var(--ink);
      border: 2px solid var(--ink);
      border-radius: 999px;
      color: var(--white);
      display: inline-flex;
      font-size: 0.9rem;
      font-weight: 760;
      gap: 12px;
      justify-content: center;
      min-height: 48px;
      padding: 12px 18px;
      text-decoration: none;
      transition: background 180ms ease, color 180ms ease, transform 180ms ease;
    }

    .cta::after {
      content: "↗";
      font-size: 1.05em;
    }

    .cta:hover {
      background: var(--yellow);
      color: var(--ink);
      transform: translateY(-2px);
    }

    .cta.secondary {
      background: transparent;
      color: var(--ink);
    }

    .cta.secondary::after { content: "↓"; }

    .cta.secondary:hover {
      background: var(--ink);
      color: var(--white);
    }

    .nav-cta {
      height: 44px;
      min-height: 44px;
      padding: 9px 15px;
    }

    .eyebrow {
      color: var(--blue);
      font-size: 0.74rem;
      font-weight: 820;
      letter-spacing: 0.14em;
      margin: 0;
      text-transform: uppercase;
    }

    .dark .eyebrow { color: var(--blue-bright); }

    .section-shell {
      margin: 0 auto;
      max-width: var(--max);
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }

    .hero {
      min-height: calc(100vh - 112px);
      padding: clamp(38px, 4.5vw, 66px) 0 clamp(48px, 5.5vw, 76px);
    }

    .hero-grid {
      align-items: center;
      display: grid;
      gap: clamp(36px, 4.5vw, 68px);
      grid-template-columns: minmax(0, 0.94fr) minmax(440px, 1.06fr);
    }

    .hero-copy h1 {
      font-size: clamp(3.95rem, 6.15vw, 6.35rem);
      font-weight: 570;
      letter-spacing: -0.06em;
      line-height: 0.88;
      margin: 18px 0 22px;
      max-width: 9ch;
    }

    .hero-copy > .eyebrow {
      font-size: 0.82rem;
      letter-spacing: 0.12em;
    }

    .hero-copy h1 em {
      color: var(--orange-ink);
      font-style: normal;
    }

    .hero-support {
      color: #424955;
      font-size: clamp(1.16rem, 1.45vw, 1.38rem);
      line-height: 1.43;
      margin: 0;
      max-width: 39rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 26px;
    }

    .hero-proofline {
      align-items: center;
      color: var(--muted);
      display: flex;
      font-size: 1.125rem;
      gap: 10px;
      margin: 18px 0 0;
    }

    .hero-proofline::before {
      background: var(--mint);
      border-radius: 50%;
      content: "";
      height: 9px;
      width: 9px;
    }

    .mobile-offer-line { display: none; }

    .system-visual {
      background: var(--night);
      border-top: 5px solid var(--yellow);
      color: var(--white);
      min-height: 540px;
      overflow: hidden;
      padding: clamp(26px, 3.4vw, 44px);
      position: relative;
      scroll-margin-top: 96px;
    }

    .system-visual :focus-visible {
      outline-color: var(--yellow);
    }

    .section.dark :focus-visible,
    .final-cta :focus-visible,
    .evidence-receipt :focus-visible {
      outline-color: var(--yellow);
    }

    .visual-topline {
      align-items: center;
      display: flex;
      justify-content: space-between;
      position: relative;
      z-index: 2;
    }

    .visual-topline span:first-child {
      color: #aeb6c5;
      font-size: 0.72rem;
      font-weight: 780;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .example-range {
      color: #98a2b4;
      font-size: 0.72rem;
      font-weight: 780;
      letter-spacing: 0.1em;
      position: relative;
      text-transform: uppercase;
      z-index: 3;
    }

    .system-title {
      font-size: clamp(2rem, 3.2vw, 3.25rem);
      font-weight: 560;
      letter-spacing: -0.05em;
      line-height: 1;
      margin: 34px 0 0;
      max-width: 11ch;
      position: relative;
      z-index: 2;
    }

    .scenario-controls {
      display: grid;
      gap: 8px;
      grid-template-columns: repeat(4, 1fr);
      margin: 26px 0 22px;
      position: relative;
      z-index: 2;
    }

    .scenario-button {
      background: transparent;
      border: 0;
      border-bottom: 2px solid #394252;
      color: #aeb6c5;
      cursor: pointer;
      font-size: 0.94rem;
      font-weight: 700;
      min-height: 44px;
      padding: 9px 8px;
      transition: background 160ms ease, color 160ms ease, border 160ms ease;
      white-space: nowrap;
    }

    .scenario-button:hover {
      background: var(--night-2);
      border-color: var(--blue-bright);
      color: var(--white);
    }

    .scenario-button[aria-selected="true"] {
      background: transparent;
      border-color: var(--yellow);
      color: var(--white);
    }

    .scenario-copy {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 180ms ease, transform 180ms ease;
    }

    .system-visual.is-changing .scenario-copy {
      opacity: 0;
      transform: translateY(6px);
    }

    .system-map {
      align-items: stretch;
      display: grid;
      gap: 15px;
      grid-template-areas:
        "friction arrow system"
        ". . outcomes"
        "note note note";
      grid-template-columns: minmax(0, 1fr) 42px minmax(0, 1.08fr);
      position: relative;
      z-index: 2;
    }

    .map-node {
      background: var(--night-2);
      border: 1px solid #354052;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 116px;
      padding: 18px;
      position: relative;
    }

    .map-node small {
      color: #8792a5;
      display: block;
      font-size: 0.68rem;
      font-weight: 760;
      letter-spacing: 0.1em;
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .map-node strong {
      display: block;
      font-size: 1.08rem;
      font-weight: 650;
      line-height: 1.25;
    }

    .map-node.friction {
      border-color: var(--orange);
      box-shadow: inset 5px 0 0 var(--orange);
      grid-area: friction;
    }

    .map-node.system {
      background: var(--yellow);
      border-color: var(--yellow);
      color: var(--ink);
      grid-area: system;
    }

    .map-node.system small { color: #555b00; }

    .map-arrow {
      align-items: center;
      display: flex;
      grid-area: arrow;
      justify-content: center;
      position: relative;
    }

    .map-arrow::before {
      background: #465165;
      content: "";
      height: 2px;
      width: 100%;
    }

    .map-arrow::after {
      border-bottom: 5px solid transparent;
      border-left: 7px solid #65728a;
      border-top: 5px solid transparent;
      content: "";
      position: absolute;
      right: 0;
    }

    .map-arrow i {
      animation: signal-x 1.45s ease-in-out 3;
      animation-fill-mode: both;
      background: var(--yellow);
      border-radius: 50%;
      height: 8px;
      left: 0;
      position: absolute;
      width: 8px;
    }

    .map-outcomes {
      border-top: 1px solid #7f8920;
      display: grid;
      gap: 6px;
      grid-area: outcomes;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-top: 10px;
      position: relative;
    }

    .map-outcomes::before {
      background: var(--yellow);
      content: "";
      height: 16px;
      left: 50%;
      position: absolute;
      top: -16px;
      width: 1px;
    }

    .map-outcomes span {
      align-items: center;
      border-bottom: 1px solid #465165;
      color: #cfd5df;
      display: flex;
      font-size: 1rem;
      gap: 8px;
      padding: 11px 2px;
    }

    .map-outcomes span::before {
      background: var(--blue-bright);
      border-radius: 50%;
      content: "";
      flex: 0 0 auto;
      height: 7px;
      width: 7px;
    }

    .visual-note {
      color: #98a2b4;
      font-size: 1.125rem;
      grid-area: note;
      line-height: 1.45;
      margin: 18px 0 0;
      max-width: 35rem;
      padding-bottom: 10px;
      position: relative;
      z-index: 2;
    }

    .evidence-return {
      align-items: center;
      color: var(--yellow);
      display: inline-flex;
      font-size: 0.875rem;
      font-weight: 720;
      min-height: 44px;
      position: relative;
      text-decoration-color: #7a8220;
      text-underline-offset: 4px;
      z-index: 2;
    }

    .section {
      border-top: 1px solid var(--line);
      padding: clamp(86px, 11vw, 154px) 0;
    }

    #recognition { padding-top: clamp(72px, 8vw, 110px); }
    #first-build,
    #fit { padding-top: clamp(72px, 8vw, 110px); }

    .offer-bridge {
      background: var(--white);
      border: 1px solid var(--line);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin: clamp(70px, 9vw, 118px) 0 0;
    }

    .offer-step {
      min-height: 164px;
      padding: 26px 28px;
      position: relative;
    }

    .offer-step + .offer-step { border-left: 1px solid var(--line); }

    .offer-step small {
      color: var(--blue);
      display: block;
      font-size: 0.72rem;
      font-weight: 820;
      letter-spacing: 0.12em;
      margin-bottom: 18px;
      text-transform: uppercase;
    }

    .offer-step small b {
      color: var(--ink);
      font-weight: 850;
      margin-right: 8px;
    }

    .offer-step strong {
      display: block;
      font-size: clamp(1.25rem, 1.8vw, 1.65rem);
      font-weight: 620;
      letter-spacing: -0.035em;
      line-height: 1.18;
    }

    .offer-step p {
      color: var(--muted);
      font-size: 1.08rem;
      line-height: 1.5;
      margin: 10px 0 0;
    }

    .offer-step::after {
      background: var(--blue);
      bottom: 0;
      content: "";
      height: 5px;
      left: 0;
      position: absolute;
      width: 100%;
    }

    .offer-step:nth-child(2)::after { background: var(--orange); }
    .offer-step:nth-child(3)::after { background: var(--mint); }

    .section.dark {
      background: var(--night);
      border-color: #2e3746;
      color: var(--white);
    }

    #see-the-system {
      border-image: linear-gradient(90deg, var(--blue) 0 25%, var(--orange) 25% 50%, var(--mint) 50% 75%, var(--yellow) 75% 100%) 1;
      border-top-width: 8px;
      padding-bottom: clamp(72px, 8vw, 110px);
    }

    .section-head {
      display: grid;
      gap: 24px;
      grid-template-columns: minmax(0, 0.95fr) minmax(340px, 0.75fr);
      justify-content: space-between;
      margin-bottom: clamp(48px, 7vw, 92px);
    }

    .section-head h2 {
      font-size: var(--display-section);
      font-weight: 550;
      letter-spacing: -0.065em;
      line-height: 0.92;
      margin: 16px 0 0;
      max-width: 11ch;
    }

    .section-head p:last-child {
      align-self: end;
      color: var(--muted);
      font-size: clamp(1.12rem, 1.55vw, 1.32rem);
      line-height: 1.55;
      margin: 0;
      max-width: 38rem;
    }

    .dark .section-head p:last-child { color: #b4bcc9; }

    #recognition .section-head h2,
    #fit .section-head h2 {
      font-size: var(--display-supporting);
    }

    .moment-list {
      border-top: 1px solid var(--ink);
    }

    .moment-row {
      align-items: center;
      border-bottom: 1px solid var(--line);
      display: grid;
      gap: 24px;
      grid-template-columns: 56px minmax(0, 1fr) minmax(210px, 0.5fr);
      min-height: 130px;
      padding: 22px 0;
    }

    .moment-number {
      align-items: center;
      background: var(--ink);
      color: var(--white);
      display: flex;
      font-size: 0.76rem;
      font-weight: 800;
      height: 36px;
      justify-content: center;
      width: 36px;
    }

    .moment-row strong {
      font-size: clamp(1.35rem, 2.1vw, 2.05rem);
      font-weight: 550;
      letter-spacing: -0.035em;
      line-height: 1.18;
    }

    .moment-state {
      align-items: center;
      color: #555c67;
      display: flex;
      font-size: 0.82rem;
      gap: 12px;
      justify-self: end;
    }

    .moment-state::before {
      background: var(--blue);
      content: "";
      height: 3px;
      width: 54px;
    }

    .moment-row:nth-child(2) .moment-state::before { background: var(--blue); }
    .moment-row:nth-child(3) .moment-state::before { background: var(--orange); }
    .moment-row:nth-child(4) .moment-state::before { background: var(--mint); }

    .owner-line {
      background: var(--yellow);
      color: var(--ink);
      font-size: clamp(1.45rem, 2.8vw, 2.6rem);
      font-weight: 580;
      letter-spacing: -0.045em;
      line-height: 1.15;
      margin-top: 40px;
      padding: clamp(24px, 3.4vw, 42px);
    }

    .systems-intro {
      align-items: end;
      display: flex;
      justify-content: space-between;
      margin-bottom: 40px;
    }

    .systems-intro h2 {
      font-size: var(--display-section);
      font-weight: 550;
      letter-spacing: -0.067em;
      line-height: 0.9;
      margin: 18px 0 0;
      max-width: 9ch;
    }

    .systems-intro p:last-child {
      color: #b4bcc9;
      font-size: 1.16rem;
      line-height: 1.55;
      margin: 0;
      max-width: 34rem;
    }

    .system-bands {
      border-top: 1px solid #394252;
    }

    .system-band {
      align-items: center;
      border-bottom: 1px solid #394252;
      display: grid;
      gap: clamp(18px, 4vw, 54px);
      grid-template-columns: 72px minmax(180px, 0.42fr) minmax(0, 0.8fr) minmax(210px, 0.68fr);
      min-height: 138px;
      overflow: hidden;
      padding: 24px 0 24px 18px;
      position: relative;
    }

    .system-band::before {
      background: var(--blue);
      content: "";
      height: 100%;
      left: 0;
      position: absolute;
      top: 0;
      transform: scaleY(1);
      transform-origin: bottom;
      transition: transform 260ms ease;
      width: 7px;
    }

    .system-band:nth-child(2)::before { background: var(--orange); }
    .system-band:nth-child(3)::before { background: var(--mint); }
    .system-band:nth-child(4)::before { background: var(--yellow); }
    .system-band:hover::before { transform: scaleY(0.72); }

    .system-band .index {
      color: #737f91;
      font-size: 0.76rem;
      font-weight: 760;
      letter-spacing: 0.12em;
    }

    .system-band h3 {
      font-size: clamp(1.55rem, 2.4vw, 2.35rem);
      font-weight: 560;
      letter-spacing: -0.04em;
      margin: 0;
    }

    .system-band p {
      color: #b4bcc9;
      font-size: 1.125rem;
      line-height: 1.5;
      margin: 0;
    }

