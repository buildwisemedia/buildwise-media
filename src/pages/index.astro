---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Custom AI Systems for Owner-Led Service Businesses | Buildwise Media';
const description = 'Buildwise Media builds custom AI systems around one consequential operational constraint chosen by the owner. The paid 90-day Pilot is $15,000 up front.';

const pageSchemas = [
  {
    '@type': 'Service',
    '@id': 'https://buildwisemedia.com/#custom-ai-pilot',
    name: 'Buildwise Media 90-Day Custom AI Pilot',
    serviceType: 'Custom AI system design, connection, and testing',
    provider: { '@id': 'https://buildwisemedia.com/#org' },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Owner-led service businesses',
    },
    description:
      'A paid 90-day Pilot focused on one consequential operational constraint chosen by the owner. The Buildwise team builds, connects, and tests a custom AI system around that constraint against agreed evidence.',
    offers: { '@id': 'https://buildwisemedia.com/#pilot-offer' },
  },
  {
    '@type': 'Offer',
    '@id': 'https://buildwisemedia.com/#pilot-offer',
    name: '90-Day Custom AI Pilot',
    url: 'https://buildwisemedia.com/book',
    price: '15000',
    priceCurrency: 'USD',
    description: '$15,000 paid up front for a 90-day Pilot around one owner-chosen operational constraint.',
    seller: { '@id': 'https://buildwisemedia.com/#org' },
  },
];

const constraintExamples = [
  { code: '01', label: 'INTAKE', detail: 'A customer request crosses too many hands before anyone can act.' },
  { code: '02', label: 'REVIEW', detail: 'Important decisions wait on scattered documents, context, or approvals.' },
  { code: '03', label: 'VISIBILITY', detail: 'The owner cannot see the operating truth without assembling it manually.' },
];

const buildLayers = [
  { label: 'CORE', title: 'The custom AI system', body: 'Selected, built, connected, and tested around the chosen constraint.' },
  { label: 'ENABLE', title: 'Only what makes it work', body: 'Bounded enabling work is included when the system needs it, with a named scope exit.' },
  { label: 'OUTSIDE', title: 'Open-ended operation', body: 'Ongoing marketing, lead-generation responsibility, and revenue accountability require separate ownership and approval.' },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={pageSchemas}
  homepageRefresh
>
  <div class="home-refresh">
    <section class="hero section-shell" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">CUSTOM AI SYSTEMS · 90-DAY PILOT</p>
          <h1 id="hero-title" class="h-hero">Choose the constraint.<br /><span>We build the system around it.</span></h1>
          <p class="hero-sub">You bring one consequential operating constraint. The Buildwise team builds, connects, and tests a custom AI system around it—then shows you the evidence.</p>
          <div class="hero-actions">
            <a class="cta" href="/book" data-cta-source="homepage-hero">See If We're a Fit</a>
            <a class="text-link" href="#see-the-system">See the System <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <figure class="hero-system" aria-labelledby="hero-system-caption">
          <!-- @r020:F2: The owner-to-system-to-evidence decision path proves the mechanism before the first CTA decision. -->
          <svg viewBox="0 0 620 560" role="img" aria-labelledby="hero-system-title hero-system-desc">
            <title id="hero-system-title">Owner-selected constraint becomes a tested custom AI system</title>
            <desc id="hero-system-desc">Three connected stages show the owner selecting the constraint, Buildwise connecting the system, and agreed evidence deciding what follows.</desc>
            <path class="line" d="M92 102H310V272H528V442" />
            <path class="line dim" d="M92 442H310V272H528V102" />
            <circle class="node hollow" cx="92" cy="102" r="18" />
            <circle class="node hollow" cx="310" cy="272" r="18" />
            <circle class="node verdict" cx="528" cy="442" r="18" />
            <circle class="node-dot" cx="92" cy="102" r="4" />
            <circle class="node-dot" cx="310" cy="272" r="4" />
            <circle class="node-dot dark" cx="528" cy="442" r="4" />
            <text class="stage-index" x="60" y="58">01</text>
            <text class="stage-title" x="60" y="151">OWNER SELECTS</text>
            <text class="stage-note" x="60" y="174">ONE CONSTRAINT</text>
            <text class="stage-index" x="278" y="228">02</text>
            <text class="stage-title" x="278" y="321">SYSTEM CONNECTS</text>
            <text class="stage-note" x="278" y="344">BUILD + TEST</text>
            <text class="stage-index yellow" x="496" y="398">03</text>
            <text class="stage-title yellow" x="390" y="491">EVIDENCE DECIDES</text>
            <text class="stage-note" x="426" y="514">AGREED BEFORE BUILD</text>
            <path class="bracket" d="M42 75V40H194" />
            <path class="bracket" d="M578 468V518H426" />
          </svg>
          <figcaption id="hero-system-caption">The owner keeps the decision. The system makes the chosen work observable.</figcaption>
        </figure>
      </div>
      <div class="container hero-ledger" aria-label="Pilot facts">
        <span>ONE CHOSEN CONSTRAINT</span><span>90-DAY PILOT</span><span>$15K PAID UP FRONT</span><span>AGREED EVIDENCE</span>
      </div>
    </section>

    <section class="section-shell constraint-section" aria-labelledby="constraint-title">
      <div class="container split-head">
        <p class="section-index">01 / CHOOSE</p>
        <div>
          <h2 id="constraint-title" class="h-section">Start where the business is actually constrained.</h2>
          <p class="lede">Not with a menu of AI features. Not with a predetermined outcome. The Pilot begins with the operating constraint you decide is consequential enough to address.</p>
        </div>
      </div>

      <div class="container constraint-ledger" aria-label="Illustrative operational constraint categories">
        {constraintExamples.map((item) => (
          <article class="constraint-row">
            <span class="row-code">{item.code}</span>
            <h3>{item.label}</h3>
            <p>{item.detail}</p>
            <!-- @r020:F2: The converging line shows that varied operating constraints still resolve to one owner-chosen decision point. -->
            <svg viewBox="0 0 180 38" aria-hidden="true" class="row-signal">
              <path d="M0 19H144" />
              <path d="M144 19L163 6M144 19L163 32" />
              <circle cx="172" cy="19" r="5" />
            </svg>
          </article>
        ))}
      </div>
      <p class="container illustrative-note">Illustrative categories, not promised results. The specific constraint is chosen with you.</p>
    </section>

    <section id="see-the-system" class="section-shell system-section" aria-labelledby="system-title">
      <div class="container split-head">
        <p class="section-index">02 / SYSTEM</p>
        <div>
          <h2 id="system-title" class="h-section">Select. Build + connect. Test against evidence.</h2>
          <p class="lede">Ninety days is the operating period for the Pilot. It describes the work and evidence cycle—not a guaranteed business result.</p>
        </div>
      </div>

      <figure class="container mechanism-map" aria-labelledby="mechanism-caption">
        <!-- @r020:F2: This is the page's primary proof diagram, making the full 90-day mechanism and human decision gates visible without motion. -->
        <svg viewBox="0 0 1180 470" role="img" aria-labelledby="mechanism-title mechanism-desc">
          <title id="mechanism-title">The 90-day Pilot mechanism</title>
          <desc id="mechanism-desc">Three connected phases show the owner selecting a constraint, Buildwise building and connecting the custom system, and both parties reviewing agreed evidence with human decisions visible.</desc>
          <path class="mechanism-spine" d="M112 236H1068" />
          <path class="mechanism-progress" d="M112 236H590" />
          <g transform="translate(112 236)">
            <circle class="phase-node" r="28" />
            <circle class="phase-dot" r="5" />
            <text class="phase-number" x="-13" y="-60">01</text>
            <text class="phase-title" x="-44" y="78">SELECT</text>
            <text class="phase-copy" x="-72" y="112">OWNER NAMES THE</text>
            <text class="phase-copy" x="-72" y="132">CONSTRAINT + EVIDENCE</text>
          </g>
          <g transform="translate(590 236)">
            <circle class="phase-node" r="28" />
            <circle class="phase-dot" r="5" />
            <text class="phase-number" x="-13" y="-60">02</text>
            <text class="phase-title" x="-97" y="78">BUILD + CONNECT</text>
            <text class="phase-copy" x="-97" y="112">THE TEAM SHAPES THE</text>
            <text class="phase-copy" x="-97" y="132">CUSTOM AI SYSTEM</text>
          </g>
          <g transform="translate(1068 236)">
            <circle class="phase-node phase-node--verdict" r="28" />
            <circle class="phase-dot phase-dot--dark" r="5" />
            <text class="phase-number phase-number--yellow" x="-13" y="-60">03</text>
            <text class="phase-title" x="-88" y="78">TEST + EVIDENCE</text>
            <text class="phase-copy" x="-88" y="112">HUMAN REVIEW DECIDES</text>
            <text class="phase-copy" x="-88" y="132">WHAT FOLLOWS</text>
          </g>
          <path class="day-bracket" d="M112 54V25H1068V54" />
          <text class="day-label" x="522" y="18">DAY 1 — DAY 90</text>
          <g class="human-gate" transform="translate(590 394)">
            <path d="M-128 0H128" />
            <circle cx="0" cy="0" r="7" />
            <text x="0" y="42" text-anchor="middle">HUMAN DECISIONS STAY VISIBLE</text>
          </g>
        </svg>
        <ol class="mechanism-mobile" aria-label="The 90-day Pilot mechanism">
          <!-- @r020:F2: The vertical mobile sequence preserves every phase and the human decision gate without horizontal scrolling. -->
          <li><span>01</span><div><strong>Select</strong><p>Owner names the constraint and the evidence.</p></div></li>
          <li><span>02</span><div><strong>Build + connect</strong><p>The team shapes the custom AI system.</p></div></li>
          <li class="mechanism-mobile__verdict"><span>03</span><div><strong>Test + evidence</strong><p>Human review decides what follows.</p></div></li>
        </ol>
        <figcaption id="mechanism-caption">One constraint. One bounded build-and-test cycle. Evidence agreed before the system is judged.</figcaption>
      </figure>
    </section>

    <section class="section-shell build-section" aria-labelledby="build-title">
      <div class="container split-head">
        <p class="section-index">03 / BUILD</p>
        <div>
          <h2 id="build-title" class="h-section">A custom AI system—not an open-ended catch-all.</h2>
          <p class="lede">The work stays centered on the chosen constraint. Anything adjacent must earn its place by making that system function.</p>
        </div>
      </div>

      <div class="container build-boundary">
        <div class="boundary-visual">
          <!-- @r020:F2: The nested boundary makes core work, bounded enablement, and excluded open-ended responsibility immediately scannable. -->
          <svg viewBox="0 0 520 520" role="img" aria-labelledby="boundary-title boundary-desc">
            <title id="boundary-title">Scope boundary for the custom AI Pilot</title>
            <desc id="boundary-desc">A bright center represents the custom AI system, a bounded ring represents necessary enabling work, and the outer field represents separately owned open-ended work.</desc>
            <rect class="outer-boundary" x="22" y="22" width="476" height="476" />
            <rect class="enable-boundary" x="92" y="92" width="336" height="336" />
            <path class="core-shape" d="M260 150L370 260L260 370L150 260Z" />
            <circle class="core-dot" cx="260" cy="306" r="12" />
            <text class="boundary-label" x="48" y="62">SEPARATE OWNERSHIP</text>
            <text class="boundary-label" x="118" y="132">BOUNDED ENABLEMENT</text>
            <text class="boundary-label boundary-label--core" x="205" y="242">CUSTOM AI</text>
            <text class="boundary-label boundary-label--core" x="220" y="266">SYSTEM</text>
          </svg>
        </div>
        <div class="boundary-copy">
          {buildLayers.map((layer, index) => (
            <article class="boundary-item">
              <p class="boundary-kicker"><span>{String(index + 1).padStart(2, '0')}</span>{layer.label}</p>
              <h3>{layer.title}</h3>
              <p>{layer.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section-shell evidence-section" aria-labelledby="evidence-title">
      <div class="container split-head">
        <p class="section-index">04 / CONTROL</p>
        <div>
          <h2 id="evidence-title" class="h-section">Evidence is part of the build—not a story added afterward.</h2>
          <p class="lede">The review standard is named before the system is judged. You stay close to the decisions, and agreement terms govern the rights in client materials, data, and output.</p>
        </div>
      </div>

      <div class="container evidence-grid">
        <figure class="evidence-console" aria-labelledby="evidence-console-caption">
          <!-- @r020:F2: The evidence ledger demonstrates how a claim moves from proposed to human-reviewed without fabricating a client result. -->
          <svg viewBox="0 0 640 430" role="img" aria-labelledby="evidence-console-title evidence-console-desc">
            <title id="evidence-console-title">An agreed-evidence review ledger</title>
            <desc id="evidence-console-desc">A four-row system ledger shows the constraint, baseline, test, and human review as explicit states.</desc>
            <rect class="console-frame" x="1" y="1" width="638" height="428" />
            <path class="console-rule" d="M1 66H639M1 157H639M1 248H639M1 339H639" />
            <text class="console-head" x="28" y="39">EVIDENCE LEDGER</text>
            <text class="console-meta" x="505" y="39">PILOT / 01</text>
            <text class="console-index" x="28" y="111">01</text>
            <text class="console-label" x="92" y="104">CONSTRAINT</text>
            <text class="console-value" x="92" y="129">DEFINED WITH OWNER</text>
            <circle class="console-state" cx="589" cy="111" r="7" />
            <text class="console-index" x="28" y="202">02</text>
            <text class="console-label" x="92" y="195">BASELINE</text>
            <text class="console-value" x="92" y="220">RECORDED BEFORE BUILD</text>
            <circle class="console-state" cx="589" cy="202" r="7" />
            <text class="console-index" x="28" y="293">03</text>
            <text class="console-label" x="92" y="286">TEST</text>
            <text class="console-value" x="92" y="311">CHECKED AGAINST AGREEMENT</text>
            <circle class="console-state hollow" cx="589" cy="293" r="7" />
            <text class="console-index" x="28" y="384">04</text>
            <text class="console-label" x="92" y="377">HUMAN REVIEW</text>
            <text class="console-value" x="92" y="402">DECISION REMAINS VISIBLE</text>
            <path class="console-verdict" d="M578 384H600" />
          </svg>
          <figcaption id="evidence-console-caption">Illustrative review structure. Evidence is defined for the chosen constraint; it is not a universal result promise.</figcaption>
        </figure>
        <div class="evidence-principles">
          <article><span>01</span><h3>Agree before build</h3><p>Define what will count as evidence before implementation begins.</p></article>
          <article><span>02</span><h3>Keep decisions visible</h3><p>Human review stays explicit at consequential points in the Pilot.</p></article>
          <article><span>03</span><h3>Govern the rights</h3><p>Rights in client materials, data, and output follow the applicable signed agreement.</p></article>
        </div>
      </div>
    </section>

    <section class="section-shell investment-section" aria-labelledby="investment-title">
      <div class="container investment-grid">
        <div class="investment-copy">
          <p class="section-index">05 / INVESTMENT</p>
          <h2 id="investment-title" class="h-section">One paid Pilot. One clear decision.</h2>
          <p class="lede">The entry engagement is designed to determine whether a custom system can address the chosen constraint against the evidence you agreed to review.</p>
          <a class="cta" href="/book" data-cta-source="homepage-investment">See If We're a Fit</a>
        </div>
        <div class="investment-figure" aria-label="Pilot investment facts">
          <!-- @r020:F3: The price and duration share one decisive visual field so the CTA follows the exact commitment being evaluated. -->
          <svg viewBox="0 0 610 520" role="img" aria-labelledby="investment-visual-title investment-visual-desc">
            <title id="investment-visual-title">Ninety-day Pilot for fifteen thousand dollars paid up front</title>
            <desc id="investment-visual-desc">A large 90 and $15,000 are connected by one line, with agreed evidence and one chosen constraint shown as the terms of the decision.</desc>
            <path class="investment-line" d="M34 260H576" />
            <circle class="investment-node" cx="34" cy="260" r="8" />
            <circle class="investment-node investment-node--end" cx="576" cy="260" r="8" />
            <text class="investment-number" x="24" y="206">90</text>
            <text class="investment-unit" x="30" y="242">DAYS</text>
            <text class="investment-price" x="248" y="350">$15,000</text>
            <text class="investment-unit" x="252" y="386">PAID UP FRONT</text>
            <text class="investment-label" x="32" y="458">ONE CHOSEN CONSTRAINT</text>
            <text class="investment-label" x="366" y="458">AGREED EVIDENCE</text>
            <path class="investment-corner" d="M16 84V16H84M594 436V504H526" />
          </svg>
        </div>
      </div>
    </section>

    <section class="section-shell fit-section" aria-labelledby="fit-title">
      <div class="container fit-grid">
        <div>
          <p class="section-index">06 / FIT</p>
          <h2 id="fit-title" class="h-closer">Is one constraint worth a 90-day build?</h2>
        </div>
        <div class="fit-decision">
          <p class="fit-lede">A useful fit conversation starts with three things:</p>
          <ol>
            <li><span>01</span><p>You can name an operating constraint that matters enough to address now.</p></li>
            <li><span>02</span><p>You are willing to define the evidence before the system is judged.</p></li>
            <li><span>03</span><p>You want a custom system, not an open-ended agency package or generic automation bundle.</p></li>
          </ol>
          <a class="cta cta--large" href="/book" data-cta-source="homepage-fit">See If We're a Fit</a>
          <p class="fit-note">A fit conversation is a decision step, not a commitment to begin.</p>
        </div>
      </div>
      <div class="container fit-signal" aria-hidden="true">
        <!-- @r020:F3: The final verdict line pulls the eye from qualification criteria directly into the fit CTA. -->
        <svg viewBox="0 0 1180 96">
          <path d="M0 48H1112" />
          <circle cx="1144" cy="48" r="24" />
          <circle class="fit-signal-dot" cx="1144" cy="48" r="6" />
        </svg>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-refresh { background: #050507; overflow: hidden; }
  .section-shell { position: relative; padding: clamp(96px, 12vw, 172px) 0; border-bottom: 1px solid var(--rule); }
  .hero { min-height: 100svh; padding-top: clamp(116px, 10vw, 148px); padding-bottom: 0; display: flex; flex-direction: column; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr); gap: clamp(56px, 7vw, 108px); align-items: center; flex: 1; }
  .hero-copy { max-width: 720px; }
  .eyebrow, .section-index, .boundary-kicker, .illustrative-note { font-family: var(--mono); text-transform: uppercase; letter-spacing: .16em; }
  .eyebrow { color: var(--y2); font-size: 11px; margin-bottom: 32px; }
  .hero .h-hero { font-size: clamp(54px, 5.8vw, 84px); line-height: .92; text-wrap: balance; }
  .hero .h-hero span { color: var(--ink-dim); }
  .hero-sub { margin-top: 26px; font-size: clamp(18px, 1.5vw, 21px); max-width: 620px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 30px; }
  .text-link { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-dim); min-height: 44px; display: inline-flex; align-items: center; gap: 12px; }
  .hero-system { max-width: 620px; justify-self: end; }
  .hero-system svg { width: 100%; }
  .hero-system figcaption, .mechanism-map figcaption, .evidence-console figcaption { color: var(--ink-dim); font-family: var(--mono); font-size: 12px; line-height: 1.55; letter-spacing: .12em; text-transform: uppercase; margin-top: 18px; }
  .line { fill: none; stroke: var(--y2); stroke-width: 1.5; }
  .line.dim { stroke: var(--rule-bright); }
  .node { stroke-width: 1.5; }
  .node.hollow { fill: #050507; stroke: var(--ink-dim); }
  .node.verdict { fill: var(--y2); stroke: var(--y2); }
  .node-dot { fill: var(--y2); }
  .node-dot.dark { fill: #050507; }
  .stage-index, .stage-title, .stage-note { font-family: var(--mono); fill: var(--ink-dim); letter-spacing: .12em; }
  .stage-index { font-size: 12px; }
  .stage-title { font-size: 12px; font-weight: 700; fill: var(--ink); }
  .stage-note { font-size: 9px; }
  .yellow { fill: var(--y2); }
  .bracket { fill: none; stroke: var(--rule-bright); stroke-width: 1; }
  .hero-ledger { margin-top: clamp(64px, 8vw, 112px); border-top: 1px solid var(--rule); display: grid; grid-template-columns: repeat(4, 1fr); }
  .hero-ledger span { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; color: var(--ink-dim); padding: 22px 0; border-right: 1px solid var(--rule); }
  .hero-ledger span:not(:first-child) { padding-left: 22px; }
  .hero-ledger span:last-child { border-right: 0; }
  .split-head { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: clamp(36px, 6vw, 96px); align-items: start; }
  .section-index { font-size: 10px; color: var(--y2); padding-top: 14px; }
  .split-head .h-section { max-width: 920px; }
  .split-head .lede { margin-top: 28px; }
  .constraint-ledger { margin-top: 76px; border-top: 1px solid var(--rule-bright); }
  .constraint-row { min-height: 142px; display: grid; grid-template-columns: 70px 190px minmax(260px, 1fr) 180px; gap: 28px; align-items: center; border-bottom: 1px solid var(--rule); }
  .row-code, .constraint-row h3 { font-family: var(--mono); letter-spacing: .14em; }
  .row-code { color: var(--ink-dim); font-size: 11px; }
  .constraint-row h3 { color: var(--ink); font-size: 13px; }
  .constraint-row p { color: var(--ink-dim); font-size: 17px; max-width: 520px; }
  .row-signal path { fill: none; stroke: var(--rule-bright); stroke-width: 1; }
  .row-signal circle { fill: var(--y2); }
  .illustrative-note { font-size: 12px; line-height: 1.55; color: var(--ink-dim); margin-top: 22px; }
  .system-section { background: linear-gradient(180deg, rgba(240,255,0,.02), transparent 30%); }
  .mechanism-map { margin-top: 80px; }
  .mechanism-map svg { width: 100%; }
  .mechanism-spine, .mechanism-progress, .day-bracket, .human-gate path { fill: none; stroke: var(--rule-bright); stroke-width: 1.5; }
  .mechanism-progress { stroke: var(--y2); }
  .phase-node { fill: #050507; stroke: var(--ink-dim); stroke-width: 1.5; }
  .phase-node--verdict { fill: var(--y2); stroke: var(--y2); }
  .phase-dot { fill: var(--y2); }
  .phase-dot--dark { fill: #050507; }
  .phase-number, .phase-title, .phase-copy, .day-label, .human-gate text { font-family: var(--mono); text-anchor: start; letter-spacing: .12em; }
  .phase-number { fill: var(--ink-faint); font-size: 12px; }
  .phase-number--yellow { fill: var(--y2); }
  .phase-title { fill: var(--ink); font-size: 14px; font-weight: 700; }
  .phase-copy { fill: var(--ink-dim); font-size: 11px; }
  .day-label { fill: var(--ink-dim); font-size: 10px; }
  .human-gate circle { fill: var(--y2); }
  .human-gate text { fill: var(--ink-dim); font-size: 10px; }
  .mechanism-mobile { display: none; }
  .build-boundary { display: grid; grid-template-columns: minmax(360px, .82fr) minmax(0, 1.18fr); gap: clamp(64px, 9vw, 132px); align-items: center; margin-top: 72px; }
  .boundary-visual svg { width: 100%; max-width: 520px; }
