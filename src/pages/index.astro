---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Custom AI Systems for Owner-Led Service Businesses | Buildwise Media';
const description = 'Buildwise Media builds and tests custom AI systems around one important operating problem chosen by the owner. The paid 90-day Pilot is $15,000 up front.';

const pageSchemas = [
  {
    '@type': 'Service',
    '@id': 'https://buildwisemedia.com/#custom-ai-pilot',
    name: 'Buildwise Media 90-Day Custom AI Pilot',
    serviceType: 'Custom AI system design, connection, and testing',
    provider: { '@id': 'https://buildwisemedia.com/#org' },
    audience: {
      '@type': 'BusinessAudience',
      audienceType: 'Owner-led service businesses',
    },
    description:
      'A paid 90-day Pilot focused on one consequential operational constraint chosen by the owner. The Buildwise team builds, connects, and tests a custom AI system around that constraint against agreed evidence.',
    offers: { '@id': 'https://buildwisemedia.com/#pilot-offer' },
  },
  {
    '@type': 'Offer',
    '@id': 'https://buildwisemedia.com/#pilot-offer',
    name: '90-Day Custom AI Pilot',
    url: 'https://buildwisemedia.com/book',
    price: '15000',
    priceCurrency: 'USD',
    description: '$15,000 paid up front for a 90-day Pilot around one owner-chosen operating problem.',
    seller: { '@id': 'https://buildwisemedia.com/#org' },
  },
];

const stuckWork = [
  {
    number: '01',
    state: 'WAITING',
    title: 'Requests wait for the right person.',
    body: 'A customer asks for something. The next step sits because ownership is unclear.',
    tone: 'orange',
  },
  {
    number: '02',
    state: 'MISSING',
    title: 'Decisions wait for missing context.',
    body: 'The answer exists, but it is spread across emails, documents, tools, and people.',
    tone: 'cyan',
  },
  {
    number: '03',
    state: 'REBUILT',
    title: 'You rebuild the same status by hand.',
    body: 'Before you can act, you have to piece together what happened and what comes next.',
    tone: 'green',
  },
];

const pilotSteps = [
  {
    number: '1',
    title: 'Choose the work',
    body: 'Name the problem. Agree on what a useful test should show.',
    note: 'YOU CHOOSE',
    tone: 'orange',
  },
  {
    number: '2',
    title: 'Build the system',
    body: 'We connect the right information, people, and actions.',
    note: 'WE BUILD',
    tone: 'cyan',
  },
  {
    number: '3',
    title: 'Test with real work',
    body: 'Run it. Review what happened. Decide what to change or do next.',
    note: 'WE REVIEW TOGETHER',
    tone: 'green',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={pageSchemas}
  homepageRefresh
>
  <div class="home-new">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">CUSTOM AI SYSTEMS FOR OWNER-LED BUSINESSES</p>
          <h1 id="hero-title" class="h-hero">
            Where does the work keep getting stuck?
            <span>We build the AI system for that.</span>
          </h1>
          <p class="hero-sub">
            Requests wait. Approvals drag. Important details live in too many places.
            You pick one problem. In 90 days, we build and test a custom AI system around it.
          </p>
          <div class="hero-actions">
            <a class="cta cta--hero" href="/book" data-cta-source="homepage-hero">See If We're a Fit</a>
            <a class="hero-link" href="#see-the-system">See what happens in 90 days <span aria-hidden="true">↓</span></a>
          </div>
          <ul class="hero-facts" aria-label="Pilot facts">
            <li><strong>1</strong><span>problem to solve</span></li>
            <li><strong>90</strong><span>days to build + test</span></li>
            <li><strong>$15K</strong><span>paid up front</span></li>
          </ul>
        </div>

        <div class="hero-visual" role="img" aria-label="Stuck work moves through a custom AI system and into a human-reviewed test">
          <!-- @r020:F2 proof: the first-frame visual explains the complete problem-to-system-to-review mechanism in plain language. -->
          <p class="visual-label">ONE PROBLEM. ONE SYSTEM. ONE REAL TEST.</p>
          <ol class="hero-flow">
            <li class="flow-block flow-block--orange">
              <span>YOUR TEAM BRINGS</span>
              <strong>Work that<br />keeps getting stuck</strong>
            </li>
            <li class="flow-arrow" aria-hidden="true">↓</li>
            <li class="flow-block flow-block--ink">
              <span>BUILDWISE BUILDS</span>
              <strong>A custom<br />AI system</strong>
            </li>
            <li class="flow-arrow" aria-hidden="true">↓</li>
            <li class="flow-block flow-block--green">
              <span>YOU BOTH REVIEW</span>
              <strong>What happened<br />with real work</strong>
            </li>
          </ol>
          <p class="visual-caption">You keep the business decision. The system makes the work easier to see and test.</p>
        </div>
      </div>
      <a class="next-cue next-cue--dark" href="#where-to-start">
        <span>Next</span><strong>Find the right first problem</strong><b aria-hidden="true">↓</b>
      </a>
    </section>

    <section id="where-to-start" class="chapter chapter--paper" aria-labelledby="start-title">
      <div class="container">
        <header class="chapter-head">
          <div class="chapter-number"><span>01</span><b>WHERE TO START</b></div>
          <div class="chapter-copy">
            <h2 id="start-title">Start with the work your team has to chase.</h2>
            <p>The right first problem matters now, has clear edges, and can be tested with real work.</p>
          </div>
        </header>

        <div class="stuck-list" aria-label="Examples of work that may be a good Pilot starting point">
          {stuckWork.map((item) => (
            <article class:list={['stuck-row', `stuck-row--${item.tone}`]}>
              <div class="stuck-state"><span>{item.number}</span><strong>{item.state}</strong></div>
              <div class="stuck-copy"><h3>{item.title}</h3><p>{item.body}</p></div>
              <div class="stuck-mark" aria-hidden="true"><span></span><b>→</b></div>
            </article>
          ))}
        </div>

        <div class="choice-statement">
          <span>THE RULE</span>
          <p>You choose the problem. We make the build fit the work.</p>
        </div>
      </div>
      <a class="next-cue next-cue--paper" href="#see-the-system">
        <span>Next</span><strong>See the 90-day build</strong><b aria-hidden="true">↓</b>
      </a>
    </section>

    <section id="see-the-system" class="chapter chapter--ink" aria-labelledby="system-title">
      <div class="container">
        <header class="chapter-head chapter-head--light">
          <div class="chapter-number chapter-number--light"><span>02</span><b>THE 90-DAY BUILD</b></div>
          <div class="chapter-copy">
            <h2 id="system-title">What happens in 90 days.</h2>
            <p>The 90 days cover the build and test. They do not promise a business result.</p>
          </div>
        </header>

        <!-- @r020:F2 proof: the three large stages orient the buyer to who decides, who builds, and how the Pilot is judged. -->
        <ol class="pilot-path" aria-label="The three stages of the 90-day Pilot">
          {pilotSteps.map((step) => (
            <li class:list={['pilot-step', `pilot-step--${step.tone}`]}>
              <div class="step-top"><span>{step.note}</span><strong>{step.number}</strong></div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
        <p class="pilot-note"><strong>Day 1 → Day 90</strong> The point is a working system and an honest review—not a guaranteed outcome.</p>
      </div>
      <a class="next-cue next-cue--ink" href="#what-we-build">
        <span>Next</span><strong>See what is inside the build</strong><b aria-hidden="true">↓</b>
      </a>
    </section>

    <section id="what-we-build" class="chapter chapter--yellow" aria-labelledby="build-title">
      <div class="container build-layout">
        <header class="chapter-head chapter-head--compact">
          <div class="chapter-number chapter-number--dark"><span>03</span><b>WHAT WE BUILD</b></div>
          <div class="chapter-copy chapter-copy--dark">
            <h2 id="build-title">We build only what this system needs.</h2>
            <p>The work stays tied to the problem you chose. We do not turn one Pilot into an open-ended catch-all.</p>
          </div>
        </header>

        <!-- @r020:F2 proof: the nested scope map makes the core build, necessary support, and separately owned work visually distinct. -->
        <div class="scope-map" role="img" aria-label="The custom AI system is the core. Necessary support is bounded around it. Open-ended marketing and revenue work stay separate.">
          <div class="scope-layer scope-layer--outside">
            <span>SEPARATE WORK</span>
            <p>Open-ended marketing, lead generation, and revenue ownership need a separate decision.</p>
            <div class="scope-layer scope-layer--support">
              <span>ONLY IF THE SYSTEM NEEDS IT</span>
              <p>Small supporting pieces can be included, with a clear stopping point.</p>
              <div class="scope-layer scope-layer--core">
                <span>THE CORE</span>
                <strong>Your custom<br />AI system</strong>
                <p>Built and tested for the problem you chose.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <a class="next-cue next-cue--yellow" href="#proof-and-control">
        <span>Next</span><strong>See how the system is judged</strong><b aria-hidden="true">↓</b>
      </a>
    </section>

    <section id="proof-and-control" class="chapter chapter--cream" aria-labelledby="proof-title">
      <div class="container">
        <header class="chapter-head">
          <div class="chapter-number"><span>04</span><b>PROOF + CONTROL</b></div>
          <div class="chapter-copy">
            <h2 id="proof-title">Decide how to judge the system before we build it.</h2>
            <p>We record the starting point, test the system with real work, and review what happened with you.</p>
          </div>
        </header>

        <!-- @r020:F2 proof: the before-test-review board shows the evidence path without inventing a client outcome. -->
        <div class="review-board" aria-label="Before, test, and review evidence path">
          <article class="review-stage review-stage--orange">
            <span>BEFORE</span><strong>Record what happens now.</strong><p>Start with the real process, not a guess.</p>
          </article>
          <div class="review-arrow" aria-hidden="true">→</div>
          <article class="review-stage review-stage--cyan">
            <span>TEST</span><strong>Run real work through it.</strong><p>Use the check you agreed on before the build.</p>
          </article>
          <div class="review-arrow" aria-hidden="true">→</div>
          <article class="review-stage review-stage--green">
            <span>REVIEW</span><strong>Decide what happens next.</strong><p>Keep it, change it, extend it, or stop.</p>
          </article>
        </div>

        <div class="control-strip">
          <div><span>YOU CAN SEE THE TEST</span><p>No hidden score and no mystery handoff.</p></div>
          <div><span>HUMANS KEEP THE DECISION</span><p>Important choices stay visible throughout the Pilot.</p></div>
          <div><span>THE AGREEMENT GOVERNS RIGHTS</span><p>Rights in client materials, data, and output follow the signed agreement.</p></div>
        </div>
      </div>
      <a class="next-cue next-cue--paper" href="#pilot-investment">
        <span>Next</span><strong>See the price and commitment</strong><b aria-hidden="true">↓</b>
      </a>
    </section>

    <section id="pilot-investment" class="chapter chapter--price" aria-labelledby="investment-title">
      <div class="container price-layout">
        <div class="price-copy">
          <div class="chapter-number chapter-number--light"><span>05</span><b>THE PILOT</b></div>
          <h2 id="investment-title">One problem.<br />One custom build.<br />One shared review.</h2>
          <p>This is the paid starting point for working with Buildwise.</p>
          <a class="cta cta--price" href="/book" data-cta-source="homepage-investment">See If We're a Fit</a>
        </div>
        <div class="price-figure" aria-label="The Pilot costs fifteen thousand dollars paid up front and runs for ninety days">
          <!-- @r020:F3 cta-pull: the high-contrast commitment block makes price and duration clear before the fit action. -->
          <span class="price-label">PAID UP FRONT</span>
          <strong>$15,000</strong>
          <div class="price-rule"></div>
          <b>90 days</b>
          <p>to build, connect, test, and review the system</p>
        </div>
      </div>
      <a class="next-cue next-cue--ink" href="#fit-decision">
        <span>Next</span><strong>Decide if this is the right first move</strong><b aria-hidden="true">↓</b>
      </a>
    </section>

    <section id="fit-decision" class="chapter chapter--fit" aria-labelledby="fit-title">
      <div class="container fit-layout">
        <div class="fit-heading">
          <div class="chapter-number"><span>06</span><b>FIT CHECK</b></div>
          <h2 id="fit-title">Is one part of the business worth rebuilding first?</h2>
        </div>
        <div class="fit-panel">
          <p class="fit-intro">This Pilot may fit if:</p>
          <ul>
            <li><span>1</span><p>One operating problem matters enough to address now.</p></li>
            <li><span>2</span><p>Real work can be used to test the system.</p></li>
            <li><span>3</span><p>You want a custom build—not a generic automation bundle.</p></li>
          </ul>
          <a class="cta cta--final" href="/book" data-cta-source="homepage-fit">See If We're a Fit <span aria-hidden="true">→</span></a>
          <p class="fit-note">A fit conversation is a decision step. It is not a commitment to begin.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home-new {
    --hm-ink: #0b0b0e;
    --hm-charcoal: #16161d;
    --hm-paper: #f8f6ee;
    --hm-cream: #eeeade;
    --hm-yellow: #f0ff00;
    --hm-orange: #ff8a3d;
    --hm-cyan: #38d8ff;
    --hm-green: #65ff8e;
    --hm-white: #fffef8;
    --hm-muted: #55545a;
    background: var(--hm-ink);
    color: var(--hm-white);
    overflow: hidden;
  }

  .home-new :global(.container) { max-width: 1280px; }
  .home-new p, .home-new a, .home-new li, .home-new span, .home-new b, .home-new strong { font-family: var(--sans); }

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: clamp(120px, 11vw, 168px) 0 0;
    background: var(--hm-ink);
  }
  .hero::before {
    content: '';
    position: absolute;
    width: min(46vw, 710px);
    height: 14px;
    top: 0;
    right: 0;
    background: var(--hm-yellow);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, .95fr);
    gap: clamp(54px, 7vw, 104px);
    align-items: center;
    flex: 1;
    padding-bottom: clamp(72px, 9vw, 124px);
  }
  .hero-copy { max-width: 760px; }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 8px 14px;
    color: var(--hm-ink);
    background: var(--hm-yellow);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: .07em;
    border-radius: 999px;
  }
  .hero .h-hero {
    margin-top: 30px;
    font-size: clamp(54px, 5.2vw, 78px);
    line-height: .94;
    letter-spacing: -.055em;
    text-wrap: balance;
  }
  .hero .h-hero span { display: block; margin-top: .14em; color: var(--hm-yellow); }
  .hero-sub {
    max-width: 690px;
    margin-top: 30px;
    color: #d7d6dc;
    font-size: clamp(19px, 1.65vw, 23px);
    line-height: 1.5;
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 34px; }
  .cta--hero { min-height: 58px; padding: 16px 25px; font-size: 17px; border-radius: 8px; }
  .hero-link { min-height: 52px; display: inline-flex; align-items: center; gap: 10px; color: #e6e5ea; font-size: 16px; font-weight: 700; border-bottom: 2px solid var(--hm-yellow); }
  .hero-facts { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
  .hero-facts li { min-width: 142px; display: grid; gap: 2px; padding: 13px 16px; border: 1px solid #3a3940; border-radius: 8px; }
  .hero-facts strong { color: var(--hm-yellow); font-size: 24px; line-height: 1; }
  .hero-facts span { color: #c8c7cd; font-size: 14px; line-height: 1.35; }

  .hero-visual {
    position: relative;
    background: var(--hm-yellow);
    color: var(--hm-ink);
    border-radius: 28px;
    padding: clamp(28px, 4vw, 52px);
    box-shadow: 18px 18px 0 var(--hm-cyan);
  }
  .visual-label { font-size: 15px; font-weight: 850; letter-spacing: .08em; }
  .hero-flow { list-style: none; display: grid; gap: 12px; margin-top: 28px; }
  .flow-block { border-radius: 16px; padding: 22px 24px; }
  .flow-block span { display: block; font-size: 15px; font-weight: 800; letter-spacing: .07em; }
  .flow-block strong { display: block; margin-top: 8px; font-size: clamp(24px, 2.2vw, 34px); line-height: 1.04; letter-spacing: -.035em; }
  .flow-block--orange { background: var(--hm-orange); }
  .flow-block--ink { background: var(--hm-ink); color: var(--hm-white); }
  .flow-block--green { background: var(--hm-green); }
  .flow-arrow { height: 22px; display: grid; place-items: center; font-size: 26px; font-weight: 900; line-height: 1; }
  .visual-caption { margin-top: 24px; font-size: 16px; line-height: 1.45; font-weight: 650; }

  .chapter { position: relative; padding: clamp(92px, 10vw, 148px) 0 0; }
  .chapter--paper { background: var(--hm-paper); color: var(--hm-ink); }
  .chapter--ink { background: var(--hm-charcoal); color: var(--hm-white); }
  .chapter--yellow { background: var(--hm-yellow); color: var(--hm-ink); }
  .chapter--cream { background: var(--hm-cream); color: var(--hm-ink); }
  .chapter--price { background: #101015; color: var(--hm-white); }
  .chapter--fit { background: var(--hm-paper); color: var(--hm-ink); padding-bottom: clamp(104px, 12vw, 180px); }

  .chapter-head { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: clamp(38px, 7vw, 104px); align-items: start; }
  .chapter-head--compact { grid-column: 1 / -1; }
  .chapter-number { display: flex; align-items: center; gap: 14px; padding-top: 12px; }
  .chapter-number span { width: 52px; height: 52px; display: grid; place-items: center; color: var(--hm-ink); background: var(--hm-yellow); border-radius: 50%; font-size: 18px; font-weight: 900; }
  .chapter-number b { font-size: 15px; letter-spacing: .08em; line-height: 1.2; }
  .chapter-number--light b { color: var(--hm-white); }
  .chapter-number--dark span { color: var(--hm-yellow); background: var(--hm-ink); }
  .chapter-number--dark b { color: var(--hm-ink); }
  .chapter-copy h2, .price-copy h2, .fit-heading h2 {
    max-width: 900px;
    font-size: clamp(48px, 6.2vw, 88px);
    line-height: .96;
    letter-spacing: -.05em;
    text-wrap: balance;
  }
  .chapter-copy > p { max-width: 780px; margin-top: 24px; color: var(--hm-muted); font-size: clamp(19px, 1.7vw, 23px); line-height: 1.5; }
  .chapter-head--light .chapter-copy > p { color: #c6c5ca; }
  .chapter-head--light .chapter-copy h2 { color: var(--hm-white); }
  .chapter--paper .chapter-copy h2,
  .chapter--cream .chapter-copy h2 { color: var(--hm-ink); }
  .chapter-copy--dark > p { color: #29292d; }
  .chapter-copy--dark h2 { color: var(--hm-ink); }

  .stuck-list { display: grid; gap: 18px; margin-top: 76px; }
  .stuck-row { display: grid; grid-template-columns: 170px minmax(0, 1fr) 150px; align-items: center; min-height: 176px; background: var(--hm-white); border: 3px solid var(--hm-ink); border-radius: 18px; overflow: hidden; }
  .stuck-state { height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 5px; padding: 26px; color: var(--hm-ink); }
  .stuck-state span { font-size: 18px; font-weight: 900; }
  .stuck-state strong { font-size: 15px; letter-spacing: .08em; }
  .stuck-row--orange .stuck-state { background: var(--hm-orange); }
  .stuck-row--cyan .stuck-state { background: var(--hm-cyan); }
  .stuck-row--green .stuck-state { background: var(--hm-green); }
  .stuck-copy { padding: 28px clamp(24px, 4vw, 54px); }
  .stuck-copy h3 { color: var(--hm-ink); font-size: clamp(26px, 2.8vw, 40px); line-height: 1.05; letter-spacing: -.035em; }
  .stuck-copy p { max-width: 720px; margin-top: 10px; color: #4b4a4f; font-size: 18px; line-height: 1.5; }
  .stuck-mark { display: flex; align-items: center; gap: 14px; padding: 30px; }
  .stuck-mark span { width: 54px; height: 10px; background: var(--hm-yellow); border: 2px solid var(--hm-ink); }
  .stuck-mark b { font-size: 36px; }
  .choice-statement { display: grid; grid-template-columns: 170px 1fr; gap: 36px; align-items: center; margin-top: 28px; padding: 32px; color: var(--hm-ink); background: var(--hm-yellow); border-radius: 18px; }
  .choice-statement span { font-size: 15px; font-weight: 900; letter-spacing: .08em; }
  .choice-statement p { font-size: clamp(24px, 3vw, 40px); font-weight: 800; line-height: 1.05; letter-spacing: -.03em; }

  .pilot-path { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 76px; }
  .pilot-step { min-height: 420px; display: flex; flex-direction: column; padding: clamp(28px, 3.4vw, 48px); color: var(--hm-ink); border-radius: 22px; }
  .pilot-step--orange { background: var(--hm-orange); }
  .pilot-step--cyan { background: var(--hm-cyan); transform: translateY(34px); }
  .pilot-step--green { background: var(--hm-green); transform: translateY(68px); }
  .step-top { display: flex; align-items: start; justify-content: space-between; gap: 20px; }
  .step-top span { max-width: 150px; font-size: 15px; font-weight: 900; letter-spacing: .07em; }
  .step-top strong { font-size: clamp(68px, 7vw, 104px); line-height: .75; letter-spacing: -.08em; }
  .pilot-step h3 { margin-top: auto; color: var(--hm-ink); font-size: clamp(30px, 3.1vw, 44px); line-height: 1; letter-spacing: -.04em; }
  .pilot-step p { margin-top: 14px; font-size: 18px; line-height: 1.45; }
  .pilot-note { max-width: 840px; margin: 104px 0 0 34%; padding: 24px 0 44px; color: #d5d4d9; font-size: 17px; line-height: 1.5; border-top: 2px solid var(--hm-yellow); }
  .pilot-note strong { display: block; margin-bottom: 8px; color: var(--hm-yellow); font-size: 18px; }

  .build-layout { display: grid; grid-template-columns: minmax(0, .85fr) minmax(500px, 1.15fr); gap: clamp(52px, 8vw, 118px); align-items: center; }
  .scope-map { min-width: 0; }
  .scope-layer { border-radius: 26px; }
  .scope-layer > span { display: block; font-size: 15px; font-weight: 900; letter-spacing: .08em; }
  .scope-layer > p { margin-top: 8px; font-size: 17px; line-height: 1.42; }
  .scope-layer--outside { padding: 28px; background: var(--hm-orange); }
