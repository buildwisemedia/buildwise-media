    .final-support {
      color: var(--white);
      font-size: clamp(1.15rem, 1.7vw, 1.42rem);
      line-height: 1.5;
      margin: 0 auto 34px;
      max-width: 40rem;
    }

    .final-inner .cta {
      background: var(--yellow);
      border-color: var(--yellow);
      color: var(--ink);
      cursor: pointer;
      font-size: 1.02rem;
      min-height: 58px;
      padding-left: 28px;
      padding-right: 28px;
    }

    .final-inner .cta:hover {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--white);
    }

    .decision-note {
      color: var(--white);
      font-size: 1.125rem;
      line-height: 1.4;
      margin: 16px auto 0;
      max-width: 32rem;
    }

    footer {
      background: var(--night);
      color: #c0c7d2;
      padding: 32px 0;
    }

    .footer-inner {
      align-items: center;
      display: flex;
      font-size: 0.78rem;
      justify-content: space-between;
      margin: 0 auto;
      max-width: var(--max);
      padding-left: var(--gutter);
      padding-right: var(--gutter);
      width: 100%;
    }

    .footer-inner p { margin: 0; }

    .footer-mark {
      align-items: center;
      display: flex;
      gap: 10px;
    }

    .footer-mark img {
      height: 64px;
      width: 64px;
    }

    .reveal {
      opacity: 1;
      transform: none;
      transition: transform 620ms ease;
    }

    .js .reveal {
      transform: translateY(22px);
    }

    .js .reveal.in-view {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes signal-x {
      0% { opacity: 0; transform: translateX(0); }
      20% { opacity: 1; }
      85% { opacity: 1; transform: translateX(25px); }
      100% { opacity: 0; transform: translateX(25px); }
    }

    @keyframes signal-y {
      0% { opacity: 0; transform: translateY(0); }
      20% { opacity: 1; }
      85% { opacity: 1; transform: translateY(62px); }
      100% { opacity: 0; transform: translateY(62px); }
    }

    @keyframes signal-y-mobile {
      0% { opacity: 0; transform: translateY(0); }
      20% { opacity: 1; }
      85% { opacity: 1; transform: translateY(21px); }
      100% { opacity: 0; transform: translateY(21px); }
    }

    @media (max-width: 1080px) {
      .hero-grid,
      .pilot-layout,
      .ai-layout { grid-template-columns: 1fr; }

      .hero-copy h1 { max-width: 10ch; }
      .system-visual { min-height: 560px; }
      .evidence-receipt { grid-template-columns: repeat(2, 1fr); }
      .receipt-example { grid-template-columns: repeat(2, 1fr); }
      .receipt-title { grid-column: 1 / -1; min-height: 0; }
      .receipt-item:nth-child(odd) { border-left: 0; }
      .proof-fact-grid { grid-template-columns: 1fr; }
      .proof-fact-grid p { min-height: 0; }
      .pilot-copy h2,
      .ai-copy h2 { max-width: 12ch; }
    }

    @media (max-width: 960px) {
      html { scroll-padding-top: 80px; }
      .nav-links a:not(.cta) { display: none; }
      .site-nav { align-items: stretch; flex-direction: column; padding-bottom: 0; }
      .mobile-jumps {
        border-top: 1px solid var(--line);
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        width: 100%;
      }
      .mobile-jumps a {
        color: #4e545e;
        font-size: 0.78rem;
        font-weight: 700;
        min-height: 44px;
        padding: 11px 8px 9px;
        text-align: center;
        text-decoration: none;
      }
      .mobile-jumps a + a { border-left: 1px solid var(--line); }
      .section-head { grid-template-columns: 1fr; }
      .section-head p:last-child { align-self: auto; }
      .systems-intro { align-items: start; flex-direction: column; gap: 24px; }
      .system-band { grid-template-columns: 54px minmax(160px, 0.45fr) minmax(0, 1fr); }
      .band-flow { grid-column: 2 / -1; }
      .evidence-lead { min-height: 0; }
      .evidence-receipt { grid-template-columns: repeat(2, 1fr); }
      .receipt-example { grid-template-columns: repeat(2, 1fr); }
      .receipt-title { grid-column: 1 / -1; min-height: 0; }
      .receipt-item:nth-child(odd) { border-left: 0; }
      .mobile-offer-line {
        border-left: 4px solid var(--mint);
        color: var(--ink);
        display: block;
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.4;
        margin: 22px 0 0;
        padding-left: 14px;
      }
      .hero-copy > .hero-proofline { display: none; }
    }

    @media (max-width: 700px) {
      html { scroll-padding-top: 80px; }
      .site-nav { min-height: 66px; }
