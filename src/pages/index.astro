      gap: 8px;
      grid-template-columns: 1fr 14px 1fr 14px 1fr 14px 1fr;
    }

    .upgrade-outputs span {
      background: var(--night-3);
      color: #cbd2dd;
      font-size: 0.86rem;
      padding: 14px 7px;
      text-align: center;
