    .upgrade-arrow::before {
      background: #566176;
      content: "";
      height: 100%;
      left: 0;
      position: absolute;
      top: 0;
      width: 2px;
    }

    .upgrade-arrow::after {
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      border-top: 8px solid #6d7990;
      bottom: -1px;
      content: "";
      left: -4px;
      position: absolute;
    }

    .upgrade-arrow i {
      background: var(--yellow);
      border-radius: 50%;
      height: 8px;
      left: -3px;
      position: absolute;
      top: 0;
      width: 8px;
