      justify-content: space-between;
      margin-top: 38px;
      padding-top: 24px;
    }

    .fit-action p {
      font-size: 1.25rem;
      font-weight: 650;
      margin: 0;
    }

    .fit-column {
      background: var(--white);
      border: 1px solid var(--line);
      padding: clamp(28px, 4vw, 46px);
    }

    .fit-column:last-child {
      background: var(--night);
      border-color: var(--night);
      color: var(--white);
    }

    .fit-column:last-child .fit-list li { border-color: #394252; }

    .fit-column h3 {
      font-size: clamp(1.7rem, 2.8vw, 2.6rem);
      font-weight: 570;
      letter-spacing: -0.045em;
      margin: 0 0 28px;
    }

    .fit-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .fit-list li {
      border-top: 1px solid var(--line);
      font-size: 1.125rem;
      line-height: 1.45;
      padding: 17px 0 17px 32px;
      position: relative;
    }

    .fit-list li::before {
      background: var(--mint);
      content: "";
      height: 10px;
      left: 0;
      position: absolute;
      top: 24px;
      width: 10px;
    }

    .fit-column:last-child .fit-list li::before { background: var(--orange); }

    .final-cta {
      background: var(--night);
      color: var(--white);
      overflow: hidden;
      padding: clamp(92px, 12vw, 168px) 0 clamp(72px, 8vw, 110px);
      position: relative;
    }

    .final-cta::before {
      background: linear-gradient(90deg,
        var(--blue) 0 25%,
        var(--orange) 25% 50%,
        var(--mint) 50% 75%,
        var(--yellow) 75% 100%);
      content: "";
      height: 8px;
      left: 0;
      position: absolute;
      right: 0;
      top: 0;
    }

    .final-inner {
      position: relative;
      text-align: center;
      z-index: 2;
    }

    .final-inner .eyebrow { color: var(--white); }

    .final-inner h2 {
      font-size: var(--display-decision);
      font-weight: 560;
      letter-spacing: -0.06em;
      line-height: 0.88;
      margin: 22px auto 30px;
      max-width: 11ch;
