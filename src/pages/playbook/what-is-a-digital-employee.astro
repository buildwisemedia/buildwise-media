---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "What Is a Digital Employee? — Buildwise Media";
const description = "A digital employee is an AI worker built into a business workflow. It handles repeat work while humans keep control.";
const definedTerm = { '@context': 'https://schema.org', '@type': 'DefinedTerm', '@id': 'https://buildwisemedia.com/playbook/what-is-a-digital-employee#term', name: 'What Is a Digital Employee?', description, inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': 'https://buildwisemedia.com/playbook/', name: 'Buildwise Media Playbook' } };
---
<BaseLayout title={title} description={description} jsonLd={[definedTerm]}>
  <section class="playbook-hero"><div class="container"><p class="eyebrow"><a href="/playbook" class="back-link">← Playbook</a></p><h1 class="h-hero">What is a <em>digital employee?</em></h1><p class="lede">A digital employee is an AI worker built into a business workflow. It handles repeat digital work, while high-stakes decisions stay under explicit controls.</p></div></section>
  <section class="playbook-section elev"><div class="container"><p class="section-tag">Plain answer</p><h2 class="h-section">A job-shaped part of your owned engine.</h2>
    <p class="prose"><span class="label">Available now</span> It can read an intake form, sort the request, draft a reply, update a record, or prepare the next step. A person checks risky or important work before it moves.</p>
    <p class="prose">It is not a person and does not replace the human parts of service. It takes the repeat work the owner hates at payroll-pennies. That phrase prices the intelligence against payroll, not our engineering fee.</p>
    <p class="prose">See the full <a href="/playbook/digital-employees">Digital Employees guide</a>, compare <a href="/playbook/digital-employees-vs-hiring">when to hire</a>, or explore the owned <a href="/system">system</a> and <a href="/fortress">fortress</a>.</p>
    <p class="prose qual mono">For established service businesses with real revenue. Owners looking for a savior bounce off — and that is the right outcome.</p>
  </div></section>
  <section class="playbook-cta"><div class="container"><h2 class="h-closer">Find the first job it should own.</h2><p class="cta-row"><a class="cta-primary" href="/revenue-leak-map" data-cta-source="playbook-what-is-a-digital-employee-cta-primary">Get My Free Revenue Leak Map <span class="cta-arrow">→</span></a><a class="cta-ghost" href="/book" data-cta-source="playbook-what-is-a-digital-employee-cta-secondary">See If We're a Fit</a></p></div></section>
</BaseLayout>
<style>
.playbook-hero { padding-block: clamp(96px, 13vw, 168px) clamp(64px, 8vw, 100px); } .back-link { color: var(--ink-faint); } .back-link:hover { color: var(--y2); } .h-hero em { color: var(--y2); font-style: normal; } .playbook-section,.playbook-cta { padding-block: var(--section-y); } .playbook-section .prose { color: var(--ink-dim); font-size: 18px; line-height: 1.7; max-width: 760px; } .playbook-section .prose + .prose { margin-top: 18px; } .cta-row { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
</style>
