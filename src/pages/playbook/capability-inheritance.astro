---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Capability Updates — Buildwise Media";
const description = "Capability updates are selected improvements Buildwise rolls into Ascend without a re-platforming or upgrade charge.";

const definedTerm = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  '@id': 'https://buildwisemedia.com/playbook/capability-inheritance#term',
  name: 'Capability Updates',
  description,
  inDefinedTermSet: { '@type': 'DefinedTermSet', '@id': 'https://buildwisemedia.com/playbook/', name: 'Buildwise Media Playbook' },
};
---
<BaseLayout title={title} description={description} jsonLd={[definedTerm]}>
  <section class="playbook-hero">
    <div class="container">
      <p class="eyebrow"><a href="/playbook" class="back-link">← Playbook</a></p>
      <h1 class="h-hero"><em>Capability</em> updates.</h1>
      <p class="lede">When Buildwise selects an improvement for your Ascend system, it can roll in without forcing a re-platform or adding an upgrade charge.</p>
    </div>
  </section>
  <section class="playbook-section elev">
    <div class="container">
      <p class="section-tag">Mechanism</p>
      <h2 class="h-section">The system routes to capability, not vendor lock-in.</h2>
      <p class="prose">Ascend is built as an operating layer. When better AI capability becomes available, Buildwise evaluates whether it is useful, appropriate, and ready for the deployed work. Selected improvements can then be routed into the relevant workflow with review appropriate to the job.</p>
      <p class="prose">This is a selective update process, not a promise that every new model, feature, or experimental capability will be installed. The client gets useful progress without owning the technical churn.</p>
    </div>
  </section>
  <section class="playbook-cta">
    <div class="container">
      <h2 class="h-closer">See the system built to keep improving.</h2>
      <p class="cta-row"><a class="cta-primary" href="/revenue-leak-map" data-cta-source="playbook-capability-inheritance-cta-primary">Get My Free Revenue Leak Map <span class="cta-arrow">→</span></a><a class="cta-ghost" href="/book" data-cta-source="playbook-capability-inheritance-cta-secondary">See If We're a Fit</a></p>
    </div>
  </section>
</BaseLayout>
<style>
.playbook-hero { padding-block: clamp(96px, 13vw, 168px) clamp(64px, 8vw, 100px); }
.back-link { color: var(--ink-faint); }
.back-link:hover { color: var(--y2); }
.h-hero em { color: var(--y2); font-style: normal; }
.playbook-section,.playbook-cta { padding-block: var(--section-y); }
.playbook-section .prose { color: var(--ink-dim); font-size: 18px; line-height: 1.7; max-width: 760px; }
.playbook-section .prose + .prose { margin-top: 18px; }
.cta-row { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 32px; }
</style>
