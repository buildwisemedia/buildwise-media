---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';

const title = "How the Weekly AI Build Works — Buildwise Media";
const description = "Each week we find the next revenue leak, build a fix, test it, and improve your client-owned AI engine.";

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buildwisemedia.com/' },
    { '@type': 'ListItem', position: 2, name: 'How It Works', item: 'https://buildwisemedia.com/how-it-works' },
  ],
};

const howTo = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How the weekly Ascend build works',
  description: 'Find the next revenue leak, build and test the fix, then improve the owned engine.',
  totalTime: 'P30D',
  step: [
    { '@type': 'HowToStep', name: 'Find', text: 'Find the next revenue leak against a captured baseline.' },
    { '@type': 'HowToStep', name: 'Build and test', text: 'Build the fix, connect it to the owned engine, and test it behind human gates.' },
    { '@type': 'HowToStep', name: 'Improve', text: 'Read the result, improve the engine, and choose the next leak.' },
  ],
};

const phases = [
  {
    n: '01', name: 'Find', when: 'Start with the leak',
    body: 'We map the path from demand to cash. Then we compare it with a <a href="/playbook/captured-baseline">captured baseline</a>. The next build starts with the leak closest to revenue, not the loudest idea in the room.',
    deliverables: ['Current pipeline map', 'Revenue leak ranked', 'Baseline captured', 'Next build chosen'],
  },
  {
    n: '02', name: 'Build + Test', when: 'Ship one useful fix',
    body: 'We build the fix into your owned engine. We test it against the baseline. Humans gate high-stakes decisions before anything buyer-facing goes live.',
    deliverables: ['Working fix installed', 'Tracking connected', 'Human approval gate', 'Result measured'],
  },
  {
    n: '03', name: 'Improve', when: 'Repeat each week',
    body: 'We read what happened, improve the fix, and choose the next leak. The engine gains another working part. That weekly build is the product.',
    deliverables: ['Result reviewed', 'Fix improved', 'Engine maintained', 'Next leak queued'],
  },
];

// FAQ — voice-search phrased, mined from on-page copy. FAQPage schema emitted
// alongside the rendered <FAQ> section so answer engines see matching content.
const faqs = [
  {
    q: 'What happens in each weekly build?',
    a: 'We find the next revenue leak, build and test the fix, then improve the owned engine. Humans approve high-stakes moves.',
  },
  {
    q: 'Where does the first build start?',
    a: 'It starts with a captured baseline and the revenue leak closest to cash. That gives the first fix a clear job and a number to beat.',
  },
  {
    q: 'Is this a chatbot or a strategy project?',
    a: 'No. It is client-owned AI operating infrastructure. Strategy lives in the weekly build, and each claim is checked against the baseline.',
  },
  {
    q: 'How do Pilot, Ascend, and Pro connect?',
    a: 'Pilot proves one problem. Ascend builds the engine each week. Pro builds the territory fortress. Ascend and Pro are true month-to-month after day 90.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://buildwisemedia.com/how-it-works#faq',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout title={title} description={description} jsonLd={[howTo, breadcrumb, faqSchema]}>

  <section class="how-hero">
    <div class="container how-hero-grid">
      <div class="how-hero-copy">
        <p class="eyebrow">How It Works</p>
        <h1 class="h-hero">
          One engine.<br/>
          <em>Built</em> every week.<br/>
          Problem by problem.
        </h1>
        <p class="hero-sub">
          The weekly build is the product. We find the next revenue leak, build the fix, test it, and improve what runs. This is client-owned AI operating infrastructure, with revenue as the first use case.
        </p>
        <div class="hero-ctas">
          <a href="/revenue-leak-map" class="cta" data-cta-source="how-it-works-hero-primary">Get My Free Revenue Leak Map<span class="cta-arrow" aria-hidden="true">→</span></a>
          <a href="/book" class="cta-ghost" data-cta-source="how-it-works-hero-secondary">See If We're a Fit</a>
        </div>
      </div>
      <aside class="ops-panel" aria-label="Install state">
        <div class="ops-head">
          <p class="panel-label mono">install state</p>
          <span class="ops-chip"><span class="ops-dot" aria-hidden="true"></span>baseline first</span>
        </div>
        <!-- @r020:F2 proof: Day 0→5→30 install timeline — proves the 30-day operational claim the hero makes -->
        <figure class="scene-fig hero-fig">
          <svg viewBox="0 0 300 132" role="img" aria-label="Install timeline: audit day 0 to 5, install day 5 to 30, operational and running from day 30.">
            <line class="fx-hair" x1="20" y1="66" x2="280" y2="66" />
            <polyline class="fx-hair" points="274,62 280,66 274,70" fill="none" />
            <line class="fx-hair" x1="20" y1="58" x2="20" y2="74" />
            <line class="fx-hair" x1="64" y1="58" x2="64" y2="74" />
            <line class="fx-hair" x1="248" y1="58" x2="248" y2="74" />
            <text class="fx-label" x="20" y="46" text-anchor="start">01 AUDIT</text>
            <text class="fx-label" x="150" y="46" text-anchor="middle">02 INSTALL</text>
            <text class="fx-label" x="262" y="46" text-anchor="end">03 RUN</text>
            <rect class="fx-vertex-filled" x="244" y="62" width="8" height="8" />
            <text class="fx-label-y2" x="248" y="26" text-anchor="middle">OPERATIONAL</text>
            <text class="fx-label" x="20" y="92" text-anchor="start">DAY 0</text>
            <text class="fx-label" x="248" y="92" text-anchor="middle">DAY 30</text>
            <text class="fx-caption" x="20" y="116">THREE PHASES. THIRTY DAYS. THEN IT RUNS.</text>
          </svg>
        </figure>
        <p class="panel-copy">Day 0 is the audit. Day 30 the system is operational — then weekly proof.</p>
      </aside>
    </div>
  </section>

  <section class="phases-section elev">
    <div class="container">
      <ol class="phases-list" role="list">
        {phases.map((p) => (
          <li class="phase-row reveal">
            <header class="phase-head">
              <span class="phase-num mono">{p.n}</span>
              <span class="phase-when mono">{p.when}</span>
            </header>
            <h2 class="phase-name">{p.name}</h2>
            <p class="phase-body" set:html={p.body}></p>
            <p class="phase-deliv-label kpi-label mono">What ships</p>
            <ul class="phase-deliv-list">
              {p.deliverables.map((d) => (
                <li><span class="dot live"></span><span>{d}</span></li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
      <!-- @r020:F2 proof: the weekly operating loop the install produces — search to prove, running after day 30 -->
      <figure class="scene-fig" style="max-width: 560px; margin: 48px 0 0;">
        <svg viewBox="0 0 520 96" role="img" aria-label="The weekly operating loop after install: search, answer, book, review, prove.">
          <line class="fx-hair" x1="34" y1="40" x2="486" y2="40" />
          <rect class="fx-vertex" x="30" y="36" width="8" height="8" />
          <rect class="fx-vertex" x="140" y="36" width="8" height="8" />
          <rect class="fx-vertex" x="250" y="36" width="8" height="8" />
          <rect class="fx-vertex" x="360" y="36" width="8" height="8" />
          <rect class="fx-vertex-filled" x="482" y="36" width="8" height="8" />
          <text class="fx-label" x="34" y="64" text-anchor="middle">SEARCH</text>
          <text class="fx-label" x="144" y="64" text-anchor="middle">ANSWER</text>
          <text class="fx-label" x="254" y="64" text-anchor="middle">BOOK</text>
          <text class="fx-label" x="364" y="64" text-anchor="middle">REVIEW</text>
          <text class="fx-label-y2" x="486" y="64" text-anchor="middle">PROVE</text>
          <text class="fx-caption" x="34" y="86">DAY 30+ — THE SYSTEM RUNS THIS LOOP EVERY WEEK</text>
        </svg>
      </figure>
    </div>
  </section>

  <section class="diff-section">
    <div class="container">
      <p class="section-tag">The product · <span class="label">Available now</span></p>
      <h2 class="h-section">A weekly loop that leaves an owned engine behind.</h2>
      <div class="diff-cols">
        <div class="diff-col">
          <p class="diff-label mono">Most agencies</p>
          <ul class="diff-list">
            <li>30 days of "discovery" before anything is built</li>
            <li>Strategy deck handed off; execution runs on hope</li>
            <li>Vendors don't talk; the founder is the integration layer</li>
            <li>Reports look plausible; nothing traces to a closed deal</li>
          </ul>
        </div>
        <div class="diff-col">
          <p class="diff-label mono diff-label--ours">Buildwise Media</p>
          <ul class="diff-list">
            <li>Find the next leak closest to revenue</li>
            <li>Build and test one useful fix</li>
            <li>Humans gate high-stakes decisions</li>
            <li>Improve the client-owned engine each week</li>
          </ul>
        </div>
      </div>
      <p class="diff-footer mono"><a href="/playbook/poor-four">The four failure modes</a> · <a href="/playbook/fractional-cmo-alternative">Why fractional CMO doesn't close the gap</a></p>
    </div>
  </section>

  <!-- FAQ — answer-engine extractable Q&A, matches FAQPage schema -->
  <FAQ faqs={faqs} />

  <div class="container"><p class="qual mono">For established service businesses with real revenue. Owners looking for a savior bounce off — and that is the right outcome.</p></div>

  <section class="how-cta elev">
    <div class="container ascend-cta-row">
      <div class="how-cta-copy">
        <h2 class="h-closer">Start with one problem. Build toward a fortress.</h2>
        <p class="lede" style="margin-top: 16px;">Pilot proves one problem. Ascend builds the engine each week. Pro turns that engine into a territory fortress.</p>
        <!-- @r020:F2 proof: captured baseline to live system to weekly proof backs the close before the CTA -->
        <figure class="scene-fig close-proof-fig">
          <svg viewBox="0 0 420 108" role="img" aria-label="Captured baseline becomes a live system and weekly proof.">
            <line class="fx-hair" x1="40" y1="48" x2="360" y2="48" />
            <polyline class="fx-hair" points="354,44 360,48 354,52" fill="none" />
            <rect class="fx-vertex" x="36" y="44" width="8" height="8" />
            <rect class="fx-vertex" x="196" y="44" width="8" height="8" />
            <rect class="fx-vertex-filled" x="356" y="44" width="8" height="8" />
            <text class="fx-label" x="40" y="74" text-anchor="middle">BASELINE</text>
            <text class="fx-label" x="200" y="74" text-anchor="middle">LIVE SYSTEM</text>
            <text class="fx-label-y2" x="360" y="74" text-anchor="middle">WEEKLY PROOF</text>
            <text class="fx-caption" x="40" y="96">CAPTURED FIRST. RUNNING BY DAY 30. PROVED EACH WEEK.</text>
          </svg>
        </figure>
      </div>
      <div class="cta-row" aria-label="Book a fit call">
        <a href="/revenue-leak-map" class="cta" data-cta-source="how-it-works-final-primary">Get My Free Revenue Leak Map <span class="cta-arrow" aria-hidden="true">→</span></a>
        <a href="/book" class="cta-ghost" data-cta-source="how-it-works-final-secondary">See If We're a Fit</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
.how-hero { padding-top: clamp(140px, 14vw, 180px); padding-bottom: clamp(60px, 8vw, 100px); }
.how-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 400px); gap: clamp(32px, 6vw, 72px); align-items: center; }
.how-hero-copy .eyebrow { margin-bottom: 28px; }
.how-hero-copy .h-hero { margin-bottom: 26px; }
.how-hero-copy .hero-sub { margin-bottom: 32px; max-width: 560px; }
.hero-ctas { display: flex; flex-wrap: wrap; gap: 16px; }
.ops-panel { border: 1px solid var(--rule); background: rgba(255,255,255,0.025); border-radius: 4px; padding: 24px; }
.ops-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 18px; }
.panel-label { color: var(--ink-dim); }
.ops-chip { font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-dim); display: inline-flex; align-items: center; gap: 7px; }
.ops-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal-green); }
.hero-fig { margin: 0; max-width: 100%; }
.panel-copy { margin-top: 16px; color: var(--ink-dim); font-size: 13px; line-height: 1.55; }
@media (max-width: 860px) { .how-hero-grid { grid-template-columns: 1fr; } }

.phases-section { padding-block: var(--section-y); }
.phases-list { list-style: none; display: flex; flex-direction: column; gap: 0; }
.phase-row { padding: 56px 0; border-top: 1px solid var(--rule); display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
.phase-row:last-child { border-bottom: 1px solid var(--rule); }
.phase-head { display: flex; gap: 24px; align-items: center; margin-bottom: 8px; }
.phase-num { font-size: 14px; letter-spacing: 0.25em; color: var(--y2); }
.phase-when { font-size: 11px; letter-spacing: 0.18em; color: var(--ink-faint); }
.phase-name { font-family: var(--sans); font-weight: 800; font-stretch: 75%; font-size: clamp(36px, 4vw, 56px); letter-spacing: -0.02em; line-height: 1; color: var(--ink); }
.phase-body { font-family: var(--sans); font-weight: 300; font-size: 18px; line-height: 1.65; color: var(--ink-dim); max-width: 760px; margin-bottom: 16px; }
.phase-deliv-label { color: var(--ink-faint); margin-top: 8px; }
.phase-deliv-list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; max-width: 760px; }
.phase-deliv-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.5; color: var(--ink-dim); }
.phase-deliv-list .dot { margin-top: 8px; }

.diff-section { padding-block: var(--section-y); }
.diff-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-top: 48px; }
.diff-col { background: var(--bg-card); border: 1px solid var(--rule); padding: 32px; }
.diff-label { color: var(--ink-faint); margin-bottom: 24px; }
.diff-label--ours { color: var(--y2); }
.diff-list { list-style: none; display: flex; flex-direction: column; gap: 14px; }
.diff-list li { font-size: 15px; line-height: 1.55; color: var(--ink-dim); padding-left: 14px; border-left: 1px solid var(--rule); }
.diff-col:last-child .diff-list li { border-left-color: var(--y2); }

.diff-footer { margin-top: 40px; font-size: 11px; letter-spacing: 0.18em; color: var(--ink-faint); text-align: center; text-transform: uppercase; }
.diff-footer a { color: var(--ink-dim); transition: color 180ms ease; }
.diff-footer a:hover { color: var(--y2); }

.how-cta { padding-block: 80px; }
.ascend-cta-row { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
.how-cta-copy { max-width: 620px; }
.close-proof-fig { max-width: 420px; margin-top: 28px; }
.cta-row { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: flex-end; }

@media (max-width: 720px) {
  .phase-deliv-list { grid-template-columns: 1fr; }
  .diff-cols { grid-template-columns: 1fr; }
  .ascend-cta-row { align-items: flex-start; }
  .cta-row { width: 100%; justify-content: flex-start; }
}
</style>
