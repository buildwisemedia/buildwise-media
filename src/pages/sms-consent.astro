---
// @creative-exempt: SMS carrier-compliance page — A2P 10DLC / TCR consent language (recurring-message disclosure, STOP/HELP, frequency, Msg & data rates) is mandated by carrier registration requirements and must appear verbatim; legal/compliance pages are exempt per CLAUDE.md.
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Text Message Consent — Buildwise Media";
const description = "Invited Buildwise Media clients can opt in to customer-care and project-status text messages. Consent is not a condition of purchase.";

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buildwisemedia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Text Message Consent', item: 'https://buildwisemedia.com/sms-consent' },
  ],
};
---
<BaseLayout title={title} description={description} jsonLd={[breadcrumb]}>

  <article class="legal-page" aria-labelledby="sms-title">
    <div class="container legal-container">

      <header class="legal-head">
        <p class="eyebrow">Legal</p>
        <h1 id="sms-title" class="h-hero">Text message <em>consent</em></h1>
        <p class="legal-meta mono">SMS program disclosure · Buildwise Media LLC</p>
      </header>

      <section class="prose">
        <h2 class="h-sub">What you are signing up for</h2>
        <!-- @sdt-exempt: carrier-mandated A2P/TCR compliance disclosure — legal fine print, no visual story -->
        <p><strong>Buildwise Media Client Support</strong> is a private messaging program for invited existing clients. Bob is Buildwise Media's project assistant. After we verify your invitation and mobile number, you may send a request by text or voice note. Messages may confirm receipt, ask a brief project question, provide a status update, or deliver a review or completion link. Messages are one-to-one customer support and project updates, not bulk promotional messaging.</p>
        <ul class="legal-list">
          <li><strong>Consent is not a condition of purchase.</strong> You can work with us without opting in.</li>
          <li><strong>Message frequency varies</strong> with your requests and active projects.</li>
          <li><strong>Msg &amp; data rates may apply.</strong> Your carrier's standard rates apply.</li>
          <li><strong>Reply STOP to opt out</strong> at any time, <strong>START</strong> to resubscribe, or <strong>HELP</strong> for help.</li>
        </ul>
        <p>We do not share, sell, rent, or otherwise provide your mobile number to third parties or affiliates for marketing or promotional purposes. Text messaging originator opt-in data and consent are not shared with third parties. How we handle your information is covered in our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>. Questions: <a href="mailto:hello@buildwisemedia.com">hello@buildwisemedia.com</a> or <a href="tel:+14786063370">+1 (478) 606-3370</a>. Carriers are not liable for delayed or undelivered messages.</p>

        <h2 class="h-sub">Opt in (optional)</h2>
        <!-- @sdt-exempt: carrier-mandated A2P/TCR consent mechanics — legal fine print, no visual story -->
        <p>Leave your details below. The consent box is optional — check it only if you want texts. Skip the box and we still help you the same; you just will not get texts.</p>
      </section>

      <form id="sms-consent-form" class="consent-form" novalidate>
        <div class="consent-hp" aria-hidden="true">
          <label for="sms-business-url">Business URL</label>
          <input id="sms-business-url" name="business_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="consent-field">
          <label class="mono" for="sms-name">Name</label>
          <input id="sms-name" name="name" type="text" required autocomplete="name" />
        </div>

        <div class="consent-field">
          <label class="mono" for="sms-email">Email</label>
          <input id="sms-email" name="email" type="email" required autocomplete="email" inputmode="email" />
        </div>

        <div class="consent-field">
          <label class="mono" for="sms-phone">Mobile number</label>
          <input id="sms-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" minlength="10" placeholder="(555) 123-4567" />
          <span class="fieldnote">We use this to verify your invitation and contact record. We never text you unless you check the box below.</span>
        </div>

        <p class="consent-optional mono">Optional — you can submit this form without checking the box. No box, no texts, and you can still work with us.</p>

        <label class="consent-check">
          <input id="sms-agree" name="sms_agree" type="checkbox" />
          <span>I agree to receive recurring customer-care and project-status SMS/MMS messages from Buildwise Media at the mobile number above. Messages may include request acknowledgements, brief project questions, status updates, and review or completion links. Consent is not a condition of purchase. Message frequency varies. Msg &amp; data rates may apply. Reply STOP to opt out, START to resubscribe, or HELP for help.</span>
        </label>
        <p class="consent-legal"><a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Service</a></p>

        <button type="submit" class="cta consent-submit">
          <span data-submit-label>Submit</span>
          <span data-submit-loading hidden>Sending...</span>
        </button>

        <p id="sms-status" class="consent-status mono" role="status" aria-live="polite"></p>
      </form>

    </div>
  </article>

</BaseLayout>

<script is:inline>
  (function () {
    const form = document.getElementById('sms-consent-form');
    const status = document.getElementById('sms-status');
    const submit = form?.querySelector('.consent-submit');
    const submitLabel = form?.querySelector('[data-submit-label]');
    const submitLoading = form?.querySelector('[data-submit-loading]');

    if (!form || !status || !submit || !submitLabel || !submitLoading) return;

    function setStatus(message, type) {
      status.textContent = message;
      status.dataset.state = type || '';
    }

    function setSubmitting(isSubmitting) {
      submit.disabled = isSubmitting;
      submitLabel.hidden = isSubmitting;
      submitLoading.hidden = !isSubmitting;
    }

    function value(name) {
      return String(form.elements[name]?.value || '').trim();
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      setStatus('', '');

      if (value('business_url')) {
        form.reset();
        return;
      }

      const wantsSms = !!form.elements['sms_agree']?.checked;

      const payload = {
        name: value('name'),
        email: value('email'),
        phone: value('phone'),
        message: wantsSms
          ? 'Bob client-support SMS consent v1.0 via buildwisemedia.com/sms-consent — voluntarily checked the optional consent box; agreed to recurring customer-care and project-status SMS, including acknowledgements, project questions, status updates, and review or completion links.'
          : 'Contact via buildwisemedia.com/sms-consent — optional SMS consent box left unchecked. NO SMS consent — do not text this number; email or call only.',
        intent: wantsSms ? 'sms-consent' : 'contact',
      };

      if (!payload.name || !payload.email || !payload.phone || !form.reportValidity()) {
        setStatus('Add your name, email, and mobile number.', 'error');
        return;
      }

      const phoneDigits = payload.phone.replace(/\D/g, '');
      if (phoneDigits.length < 10 || phoneDigits.length > 15) {
        setStatus('Add a valid mobile number.', 'error');
        return;
      }

      setSubmitting(true);
      try {
        const response = await fetch('https://bwm-form-handler.robert-ba0.workers.dev/buildwisemedia/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`Server ${response.status}`);
        form.reset();
        setStatus(wantsSms
          ? 'Your SMS consent was recorded. We will verify your invitation and mobile number before Bob can reply. Reply STOP to any message to opt out.'
          : 'Got it — we will follow up by email or phone call. You are not signed up for texts.', 'success');
      } catch (_) {
        setStatus('That did not go through. Try again or email hello@buildwisemedia.com.', 'error');
      } finally {
        setSubmitting(false);
      }
    });
  })();
</script>

<style>
.legal-page { padding-top: clamp(140px, 14vw, 180px); padding-bottom: var(--section-y); }
.legal-container { max-width: 760px; }
.legal-head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 56px; padding-bottom: 32px; border-bottom: 1px solid var(--rule); }
.legal-meta { font-size: 11px; letter-spacing: 0.18em; color: var(--ink-faint); }

.prose h2 { margin-top: 48px; margin-bottom: 16px; }
.prose p { margin-bottom: 18px; }
.prose strong { color: var(--ink); font-weight: 500; }

.legal-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-block: 16px 24px; padding-left: 0; }
.legal-list li {
  font-family: var(--sans);
  font-weight: 300;
  font-size: 17px;
  line-height: 1.6;
  color: var(--ink-dim);
  padding-left: 24px;
  position: relative;
}
.legal-list li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--y2);
}

.consent-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-top: 24px;
  padding: clamp(24px, 4vw, 38px);
  border: 1px solid var(--rule);
}

.consent-hp {
  position: absolute;
  left: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.consent-field { display: flex; flex-direction: column; gap: 8px; }
.consent-field label { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-faint); }
.consent-field input {
  background: transparent;
  border: 1px solid var(--rule);
  color: var(--ink);
  font-family: var(--sans);
  font-weight: 300;
  font-size: 16px;
  padding: 12px 14px;
}
.consent-field input:focus { outline: 1px solid var(--y2); outline-offset: 0; }
.fieldnote { font-family: var(--sans); font-weight: 300; font-size: 13px; line-height: 1.5; color: var(--ink-faint); }

.consent-optional { font-size: 12px; letter-spacing: 0.08em; color: var(--ink-faint); margin: 0; }

.consent-check {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  cursor: pointer;
}
.consent-check input {
  margin-top: 4px;
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  accent-color: var(--y2);
}
.consent-check span {
  font-family: var(--sans);
  font-weight: 300;
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-dim);
}
.consent-legal { margin: -6px 0 0 28px; font-size: 13px; line-height: 1.5; }

.consent-submit { align-self: flex-start; }

.consent-status { font-size: 12px; letter-spacing: 0.08em; min-height: 18px; }
.consent-status[data-state='error'] { color: var(--signal-orange); }
.consent-status[data-state='success'] { color: var(--signal-green); }
</style>
