---
// @creative-exempt: SMS carrier-compliance page — A2P 10DLC / TCR consent language (recurring-message disclosure, STOP/HELP, frequency, Msg & data rates) is mandated by carrier registration requirements and must appear verbatim; legal/compliance pages are exempt per CLAUDE.md.
import BaseLayout from '../layouts/BaseLayout.astro';
import { createHash } from 'node:crypto';

const title = "Text Message Consent — Buildwise Media";
const description = "Invited Buildwise Media clients can opt in to customer-care and project-status text messages. Consent is not a condition of purchase.";
const bobConsentText = "I agree to receive recurring customer-care and project-status SMS/MMS messages from Buildwise Media at the mobile number above. Messages may include request acknowledgements, brief project questions, status updates, and review or completion links. Consent is not a condition of purchase. Message frequency varies. Msg & data rates may apply. Reply STOP to opt out, START to resubscribe, or HELP for help.";
const bobConsentSha256 = createHash('sha256').update(bobConsentText).digest('hex');

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buildwisemedia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Text Message Consent', item: 'https://buildwisemedia.com/sms-consent' },
  ],
};
---
<BaseLayout title={title} description={description} jsonLd={[breadcrumb]} privacySensitive={true} noindex={true}>

  <article class="legal-page" aria-labelledby="sms-title">
    <div class="container legal-container">

      <header class="legal-head">
        <p class="eyebrow">Private client beta</p>
        <h1 id="sms-title" class="h-hero">Meet Bob by <em>text</em></h1>
        <p class="legal-meta mono">Invitation, consent, and mobile verification · Buildwise Media LLC</p>
      </header>

      <section class="prose">
        <h2 class="h-sub">What you are signing up for</h2>
        <!-- @sdt-exempt: carrier-mandated A2P/TCR compliance disclosure — legal fine print, no visual story -->
        <p><strong>Buildwise Media Client Support</strong> is a private beta for individually invited existing clients. Bob is Buildwise Media's project assistant. After we verify your invitation and mobile number, you may send a request by text or voice note. Bob can confirm receipt, ask a brief project question, provide a status update, or deliver a review or completion link. Messages are one-to-one customer support and project updates, not bulk promotional messaging.</p>
        <ul class="legal-list">
          <li><strong>Consent is not a condition of purchase.</strong> You can work with us without opting in.</li>
          <li><strong>Message frequency varies</strong> with your requests and active projects.</li>
          <li><strong>Msg &amp; data rates may apply.</strong> Your carrier's standard rates apply.</li>
          <li><strong>Reply STOP to opt out</strong> at any time, <strong>START</strong> to resubscribe, or <strong>HELP</strong> for help.</li>
        </ul>
        <p>We do not share, sell, rent, or otherwise provide your mobile number to third parties or affiliates for marketing or promotional purposes. Text messaging originator opt-in data and consent are not shared with third parties. How we handle your information is covered in our <a href="/privacy">Privacy Policy</a> and <a href="/terms">Terms of Service</a>. Questions: <a href="mailto:hello@buildwisemedia.com">hello@buildwisemedia.com</a>. Carriers are not liable for delayed or undelivered messages.</p>

        <h2 class="h-sub">Activate your invitation</h2>
        <!-- @sdt-exempt: carrier-mandated A2P/TCR consent mechanics — legal fine print, no visual story -->
        <p>Use the personal invitation link the Buildwise team sent you. If you choose texts, we will send a six-digit code to prove this mobile number belongs to you. Your invitation already fixes the client account and access policy Bob may use.</p>
      </section>

      <div id="invite-warning" class="consent-callout mono" hidden>
        This page needs your personal invitation link. Ask the Buildwise team to send it again; do not use someone else's link.
      </div>

      <form id="sms-consent-form" class="consent-form" novalidate hidden>
        <section data-step="details" aria-labelledby="details-title">
          <h3 id="details-title" class="form-title">Your details</h3>
          <p class="fieldnote">We match these details to your invitation. We do not use this form for lead nurture or marketing.</p>

          <div class="consent-hp" aria-hidden="true">
            <label for="sms-business-url">Business URL</label>
            <input id="sms-business-url" name="business_url" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="consent-field">
            <label class="mono" for="sms-name">Name</label>
            <input id="sms-name" name="name" type="text" required autocomplete="name" maxlength="160" />
          </div>

          <div class="consent-field">
            <label class="mono" for="sms-email">Email</label>
            <input id="sms-email" name="email" type="email" required autocomplete="email" inputmode="email" maxlength="254" />
          </div>

          <div class="consent-field">
            <label class="mono" for="sms-phone">Mobile number</label>
            <input id="sms-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" minlength="10" maxlength="40" placeholder="(555) 123-4567" />
            <span class="fieldnote">This must match the mobile number approved for your invitation.</span>
          </div>

          <p class="consent-optional mono">Optional — leave the box unchecked for no texts. We record that choice and do not activate Bob by SMS.</p>

          <label class="consent-check">
            <input id="sms-agree" name="sms_agree" type="checkbox" />
            <span data-consent-version="bob-client-support-v2.0" data-consent-sha256={bobConsentSha256}>{bobConsentText}</span>
          </label>
          <p class="consent-legal"><a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms of Service</a></p>

          <button type="submit" class="cta consent-submit">
            <span data-submit-label>Continue</span>
            <span data-submit-loading hidden>Checking...</span>
          </button>
        </section>

        <section data-step="verify" aria-labelledby="verify-title" hidden>
          <p class="step-kicker mono">Step 2 of 2</p>
          <h3 id="verify-title" class="form-title">Registration isn't finished yet</h3>
          <p class="verification-progress"><strong>Next:</strong> Read the six-digit code in Bob's text, then return here and enter it below. When you return through your personal invitation link, this page will restore the active step.</p>
          <p class="fieldnote" data-delivery-summary>Bob is asking your carrier to deliver a six-digit code. It expires in 10 minutes. Buildwise Media will never ask you to read this code back by phone or email.</p>

          <div class="delivery-help" data-delivery-help hidden>
            <p><strong>Carrier says delivered, but no code?</strong> That does not mean the message was opened.</p>
            <ul>
              <li>Check the messaging app on your phone itself, not only a linked computer.</li>
              <li>Search for Bob's number: <a href="sms:+14782196838">(478) 219-6838</a>.</li>
              <li>Check Spam &amp; blocked. If Bob is blocked, unblock him and request one fresh code.</li>
            </ul>
          </div>

          <div class="consent-field code-field">
            <label class="mono" for="sms-code">Verification code</label>
            <input id="sms-code" name="code" type="text" required disabled autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="123456" />
          </div>

          <div class="verify-actions">
            <button type="submit" class="cta consent-submit" disabled>
              <span data-verify-label>Activate Bob</span>
              <span data-verify-loading hidden>Activating...</span>
            </button>
            <button type="button" class="text-button mono" data-send-again disabled><span data-send-again-label>Send a new code</span> <span data-send-again-timer>(60s)</span></button>
            <button type="button" class="text-button mono" data-need-help disabled>I still don't see it</button>
          </div>
        </section>

        <section data-step="done" class="activation-done" aria-labelledby="done-title" hidden>
          <p class="step-kicker mono">Verified</p>
          <h3 id="done-title" class="form-title">You're in the private beta.</h3>
          <p data-done-primary>Bob's welcome text is on the way. Save that number. You can text or send a voice note about your website and active projects.</p>
          <p data-done-feedback>Bob will confirm what he understood, keep you posted, and send a review link when work is ready. Reply <strong>FEEDBACK:</strong> anytime with what feels useful, confusing, or awkward.</p>
        </section>

        <p id="sms-status" class="consent-status mono" role="status" aria-live="polite"></p>
      </form>

    </div>
  </article>

</BaseLayout>

<script is:inline>
  (function () {
    var START_URL = 'https://bwm-sms-worker.robert-ba0.workers.dev/pilot/onboarding/start';
    var RESUME_URL = 'https://bwm-sms-worker.robert-ba0.workers.dev/pilot/onboarding/resume';
    var STATUS_URL = 'https://bwm-sms-worker.robert-ba0.workers.dev/pilot/onboarding/status';
    var HELP_URL = 'https://bwm-sms-worker.robert-ba0.workers.dev/pilot/onboarding/help';
    var VERIFY_URL = 'https://bwm-sms-worker.robert-ba0.workers.dev/pilot/onboarding/verify';
    var form = document.getElementById('sms-consent-form');
    var status = document.getElementById('sms-status');
    var warning = document.getElementById('invite-warning');
    var detailsStep = form && form.querySelector('[data-step="details"]');
    var verifyStep = form && form.querySelector('[data-step="verify"]');
    var doneStep = form && form.querySelector('[data-step="done"]');
    var verifySubmit = verifyStep && verifyStep.querySelector('.consent-submit');
    var submitLabel = form && form.querySelector('[data-submit-label]');
    var submitLoading = form && form.querySelector('[data-submit-loading]');
    var verifyLabel = form && form.querySelector('[data-verify-label]');
    var verifyLoading = form && form.querySelector('[data-verify-loading]');
    var sendAgain = form && form.querySelector('[data-send-again]');
    var sendAgainLabel = form && form.querySelector('[data-send-again-label]');
    var sendAgainTimer = form && form.querySelector('[data-send-again-timer]');
    var needHelp = form && form.querySelector('[data-need-help]');
    var deliverySummary = form && form.querySelector('[data-delivery-summary]');
    var deliveryHelp = form && form.querySelector('[data-delivery-help]');
    var stateKey = 'bob-private-beta-onboarding-v1';
    var queryInviteToken = new URLSearchParams(window.location.search).get('i') || '';
    var savedState = {};
    try { savedState = JSON.parse(window.sessionStorage.getItem(stateKey) || '{}'); } catch (_) { savedState = {}; }
    var inviteToken = queryInviteToken || String(savedState.invite_token || '');
    var challengeId = '';
    var currentStep = 'details';
    var sendAgainInterval = null;
    var deliveryPollInterval = null;
    var resumeNeedsDetails = false;
    var verificationReady = false;

    if (!form || !status || !detailsStep || !verifyStep || !doneStep) return;

    if (!/^[A-Za-z0-9_-]{40,200}$/.test(inviteToken)) {
      warning.hidden = false;
      form.hidden = true;
    } else {
      if (queryInviteToken) {
        if (String(savedState.invite_token || '') !== inviteToken) savedState = { invite_token: inviteToken };
        else savedState.invite_token = inviteToken;
        window.sessionStorage.setItem(stateKey, JSON.stringify(savedState));
      }
      window.history.replaceState(null, '', window.location.pathname + window.location.hash);
      form.hidden = false;
    }

    function saveState(extra) {
      savedState = Object.assign({}, savedState, extra, { invite_token: inviteToken });
      window.sessionStorage.setItem(stateKey, JSON.stringify(savedState));
    }

    function clearState() {
      savedState = {};
      window.sessionStorage.removeItem(stateKey);
    }

    function setStatus(message, type) {
      status.textContent = message;
      status.dataset.state = type || '';
    }

    function publicErrorMessage(error, fallback) {
      var message = error && error.message ? String(error.message).trim() : '';
      if (!message || /failed to fetch|network\s*error|load failed/i.test(message)) return fallback;
      return message;
    }

    function stopDeliveryPolling() {
      if (!deliveryPollInterval) return;
      clearInterval(deliveryPollInterval);
      deliveryPollInterval = null;
    }

    function value(name) {
      return String(form.elements[name] && form.elements[name].value || '').trim();
    }

	    function setVerificationReady(ready) {
	      verificationReady = !!ready;
	      form.elements.code.disabled = !verificationReady;
	      if (verifySubmit) verifySubmit.disabled = !verificationReady;
	    }

	    function setBusy(busy, action) {
	      Array.prototype.forEach.call(form.querySelectorAll('.consent-submit'), function (button) {
	        button.disabled = busy || (button === verifySubmit && !verificationReady);
	      });
	      [sendAgain, needHelp].forEach(function (button) {
	        if (!button) return;
	        if (busy) {
	          if (!button.hasAttribute('data-disabled-before-busy')) {
	            button.setAttribute('data-disabled-before-busy', button.disabled ? 'true' : 'false');
	          }
	          button.disabled = true;
	        } else if (button.hasAttribute('data-disabled-before-busy')) {
	          button.disabled = button.getAttribute('data-disabled-before-busy') === 'true';
	          button.removeAttribute('data-disabled-before-busy');
	        }
	      });
	      if (action === 'new_code') {
        sendAgainLabel.textContent = busy ? 'Sending a new code...' : 'Send a new code';
        return;
      }
      if (action === 'details') {
        submitLabel.hidden = busy;
        submitLoading.hidden = !busy;
      } else {
        verifyLabel.hidden = busy;
        verifyLoading.hidden = !busy;
      }
    }

	    function showStep(step, focusCode) {
      currentStep = step;
      detailsStep.hidden = step !== 'details';
      verifyStep.hidden = step !== 'verify';
      doneStep.hidden = step !== 'done';
      if (step !== 'verify') setVerificationReady(false);
      else setVerificationReady(verificationReady);
      setStatus('', '');
      if (step === 'verify') {
        document.title = 'Enter your code — Bob private beta';
        if (focusCode !== false && verificationReady) form.elements.code.focus();
        startSendAgainTimer();
      } else {
        document.title = 'Text Message Consent — Buildwise Media';
      }
	      if (step !== 'verify') stopDeliveryPolling();
	      if (step !== 'verify') {
	        [sendAgain, needHelp].forEach(function (button) {
	          button.removeAttribute('data-disabled-before-busy');
	          button.disabled = true;
	        });
	      }
	    }

	    function showAwaitingReview(message) {
	      challengeId = '';
	      showStep('done');
	      doneStep.querySelector('.step-kicker').textContent = 'Number verified';
	      doneStep.querySelector('.form-title').textContent = 'The Buildwise team will review the activation.';
	      doneStep.querySelector('[data-done-primary]').textContent = message || 'Your number is verified. The Buildwise team will confirm that it matches the approved client record before Bob is activated.';
	      doneStep.querySelector('[data-done-feedback]').hidden = true;
	      saveState({ awaiting_review: true, awaiting_message: message || '', challenge_id: '', expires_at: '' });
	      setStatus('Number verified. Activation is waiting for the Buildwise team\'s review.', 'success');
	    }

    function deliveryAddress(result) {
      var destination = result.phone_last4 ? 'mobile ending ' + result.phone_last4 : 'your mobile';
      var sender = result.sender_last4 ? "Bob's number ending " + result.sender_last4 : "Bob's number";
      return { destination: destination, sender: sender };
    }

    function renderDelivery(result) {
      if (!deliverySummary || !deliveryHelp) return;
      var address = deliveryAddress(result);
      deliveryHelp.hidden = true;
      if (result.challenge_status === 'expired') {
        setVerificationReady(false);
        deliverySummary.textContent = 'That code expired. Request one fresh code below.';
        setStatus('Code expired. Request a new one.', 'error');
        return;
      }
      if (result.delivery_status === 'failed') {
        setVerificationReady(false);
        deliverySummary.textContent = 'The carrier could not deliver the code to ' + address.destination + '. Confirm the number, check that ' + address.sender + ' is not blocked, then request one fresh code.';
        setStatus('Carrier delivery failed. Check the number and try once more.', 'error');
        return;
      }
      if (result.delivery_status === 'delivered') {
        setVerificationReady(result.challenge_status === 'pending');
        deliverySummary.textContent = 'Registration is not complete yet. Your carrier reports delivery to ' + address.destination + ' from ' + address.sender + '. Enter that code below to finish.';
        deliveryHelp.hidden = false;
        setStatus('Code delivered. Return here and enter it to finish registration.', 'success');
        return;
      }
      if (result.delivery_status === 'sent') {
        setVerificationReady(result.challenge_status === 'pending');
        deliverySummary.textContent = 'Bob sent a six-digit code to ' + address.destination + ' from ' + address.sender + '. Carrier delivery may take a minute.';
        setStatus('Code sent to the carrier. Enter it when it arrives.', 'success');
        return;
      }
      setVerificationReady(false);
      deliverySummary.textContent = 'Bob is asking your carrier to deliver a six-digit code to ' + address.destination + '. Keep this page open or return through your invitation link.';
      setStatus('Waiting for the carrier to accept the verification text.', '');
    }

    async function refreshDeliveryStatus() {
      if (currentStep !== 'verify' || !challengeId) return;
      try {
        var response = await fetch(STATUS_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invite_token: inviteToken, challenge_id: challengeId }),
        });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok || result.status !== 'verification_status') return;
        // A verification submit cancels polling. Ignore any status response
        // that was already in flight so it cannot overwrite the verify result
        // or re-enable controls while verification is running.
        if (deliveryPollInterval === null || currentStep !== 'verify' || !challengeId) return;
        renderDelivery(result);
        if (result.challenge_status !== 'pending' || result.delivery_status === 'failed') {
          stopDeliveryPolling();
        }
      } catch (_) {
        // The code entry remains usable during a temporary status-read outage.
      }
    }

    function startDeliveryPolling(initialResult) {
      stopDeliveryPolling();
      renderDelivery(initialResult);
      deliveryPollInterval = setInterval(refreshDeliveryStatus, 3000);
      refreshDeliveryStatus();
    }

    function startSendAgainTimer() {
      var seconds = 60;
	      sendAgain.disabled = true;
	      needHelp.disabled = true;
	      sendAgain.removeAttribute('data-disabled-before-busy');
	      needHelp.removeAttribute('data-disabled-before-busy');
      sendAgainTimer.textContent = '(' + seconds + 's)';
      if (sendAgainInterval) clearInterval(sendAgainInterval);
      sendAgainInterval = setInterval(function () {
        seconds -= 1;
        sendAgainTimer.textContent = seconds > 0 ? '(' + seconds + 's)' : '';
        if (seconds <= 0) {
          clearInterval(sendAgainInterval);
          sendAgain.disabled = false;
          needHelp.disabled = false;
        }
      }, 1000);
    }

    function detailsPayload() {
      return {
        invite_token: inviteToken,
        name: value('name'),
        email: value('email'),
        phone: value('phone'),
        wants_sms: !!form.elements.sms_agree.checked,
        business_url: value('business_url'),
      };
    }

    async function requestCode() {
	      var requestAction = currentStep === 'verify' ? 'new_code' : 'details';
      var payload = detailsPayload();
      var detailFields = [form.elements.name, form.elements.email, form.elements.phone];
      if (!/^[A-Za-z0-9_-]{40,200}$/.test(inviteToken)) {
        setStatus('Ask the Buildwise team for a new personal invitation link.', 'error');
        return;
      }
      if (!payload.name || !payload.email || !payload.phone || !detailFields.every(function (field) { return field.checkValidity(); })) {
        setStatus('Add your name, email, and mobile number.', 'error');
        return;
      }
      var digits = payload.phone.replace(/\D/g, '');
      if (digits.length < 10 || digits.length > 15) {
        setStatus('Add a valid mobile number.', 'error');
        return;
      }
      setBusy(true, requestAction);
      try {
        var response = await fetch(START_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok) {
          var startMessage = result.error || 'That did not go through.';
          if (response.status === 429 && !result.error) startMessage = 'Please wait before requesting another code.';
          throw new Error(startMessage);
        }
        if (result.status === 'declined') {
          detailsStep.hidden = true;
          doneStep.hidden = false;
          doneStep.querySelector('.step-kicker').textContent = 'Choice recorded';
          doneStep.querySelector('.form-title').textContent = 'You are not signed up for texts.';
          doneStep.querySelector('[data-done-primary]').textContent = 'You can keep working with Buildwise Media by email. No Bob SMS access was activated. This invitation link is now closed; ask the Buildwise team for a new one if you change your mind.';
          doneStep.querySelector('[data-done-feedback]').hidden = true;
          currentStep = 'done';
          clearState();
          setStatus('No SMS authorization was created.', 'success');
          return;
        }
        if (result.status === 'already_active') {
          showStep('done');
          doneStep.querySelector('[data-done-primary]').textContent = "You're already set up. Bob's number is in your texts from before.";
          clearState();
          setStatus('This invitation was already activated.', 'success');
          return;
        }
        if (result.status === 'verified_awaiting_review') {
          showAwaitingReview(result.message || 'Your phone is verified. The Buildwise team is finishing your private-beta activation.');
          return;
        }
        challengeId = result.challenge_id || '';
        if (!challengeId) throw new Error('The verification text was not created.');
        resumeNeedsDetails = false;
        setVerificationReady(true);
        showStep('verify');
        saveState({
          challenge_id: challengeId,
          expires_at: result.expires_at || '',
          phone_last4: result.phone_last4 || '',
          sender_last4: result.sender_last4 || '',
          name: payload.name,
          email: payload.email,
          phone: payload.phone,
          wants_sms: payload.wants_sms,
        });
        startDeliveryPolling({
          challenge_status: 'pending',
          delivery_status: 'sent',
          phone_last4: result.phone_last4 || '',
          sender_last4: result.sender_last4 || '',
        });
      } catch (error) {
        setStatus(publicErrorMessage(error, 'We could not reach Bob right now. Your registration was not changed. Try again in a moment or ask the Buildwise team for help.'), 'error');
      } finally {
        setBusy(false, requestAction);
      }
    }

    async function verifyCode() {
      var code = value('code');
      if (!/^[0-9]{6}$/.test(code)) {
        setStatus('Enter the six-digit code from Bob.', 'error');
        return;
      }
      // Keep the verification result visible. Delivery polling has already
      // done its job and must not overwrite an invalid/expired-code message.
      stopDeliveryPolling();
      setBusy(true, 'verify');
      try {
        var response = await fetch(VERIFY_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invite_token: inviteToken, challenge_id: challengeId, code: code }),
        });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok) {
          var verifyMessage = result.error || 'That code could not be verified.';
          if (typeof result.attempts_remaining === 'number') {
            verifyMessage += ' ' + result.attempts_remaining + (result.attempts_remaining === 1 ? ' try remains.' : ' tries remain.');
          }
          setStatus(verifyMessage, 'error');
          if (response.status === 410 || result.attempts_remaining === 0) {
            sendAgain.removeAttribute('data-disabled-before-busy');
            needHelp.removeAttribute('data-disabled-before-busy');
            sendAgain.disabled = false;
            needHelp.disabled = false;
          }
          form.elements.code.select();
          return;
        }
	        if (result.status === 'verified_awaiting_review') {
	          showAwaitingReview(result.message || 'Your number is verified. The Buildwise team will review the activation.');
	          return;
	        }
        showStep('done');
        clearState();
        setStatus("Activated. Bob's welcome is on the way.", 'success');
      } catch (error) {
        setStatus(publicErrorMessage(error, 'We could not reach Bob to verify that code. Try again in a moment or ask the Buildwise team for help.'), 'error');
        form.elements.code.select();
      } finally {
        setBusy(false, 'verify');
      }
    }

    async function requestHelp() {
      if (!challengeId || needHelp.disabled) return;
      needHelp.disabled = true;
      needHelp.textContent = 'Telling the team...';
      try {
        var response = await fetch(HELP_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invite_token: inviteToken, challenge_id: challengeId }),
        });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok) throw new Error(result.error || 'We could not notify the team yet.');
        setStatus(result.message || 'We told the Buildwise team. The team will follow up.', 'success');
        needHelp.textContent = 'Team notified';
      } catch (error) {
        setStatus(publicErrorMessage(error, 'We could not notify the team yet. Email hello@buildwisemedia.com and we will help.'), 'error');
        needHelp.textContent = "I still don't see it";
        needHelp.disabled = false;
      }
    }

    async function resumeRegistration() {
      setBusy(true, 'details');
      setStatus('Checking whether your registration is already in progress...', '');
      try {
        var response = await fetch(RESUME_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invite_token: inviteToken }),
        });
        var result = await response.json().catch(function () { return {}; });
        if (!response.ok) {
          if (result.status === 'invitation_closed') {
            warning.textContent = result.message || 'This invitation is no longer active. Ask the Buildwise team for a new one.';
            warning.hidden = false;
            form.hidden = true;
            clearState();
            return;
          }
          throw new Error(result.error || 'We could not check the current registration step.');
        }
        if (result.status === 'already_active') {
          showStep('done');
          doneStep.querySelector('[data-done-primary]').textContent = "You're already registered. Bob's private number is ready for your texts and voice notes.";
          clearState();
          setStatus('Registration is complete.', 'success');
          return;
        }
        if (result.status === 'verified_awaiting_review') {
          showAwaitingReview(result.message || 'Your phone is verified. The Buildwise team is finishing your private-beta activation.');
          return;
        }
        if ((result.status === 'verification_resume' || result.status === 'verification_pending_delivery') && result.challenge_id) {
          challengeId = result.challenge_id;
          resumeNeedsDetails = !(savedState.name && savedState.email && savedState.phone);
          setVerificationReady(result.status === 'verification_resume');
          showStep('verify', false);
          saveState({
            challenge_id: challengeId,
            expires_at: result.expires_at || '',
            phone_last4: result.phone_last4 || '',
            sender_last4: result.sender_last4 || '',
          });
          startDeliveryPolling(result);
          return;
        }
        showStep('details');
        if (result.status === 'restart_required') {
          clearState();
          savedState = { invite_token: inviteToken };
          window.sessionStorage.setItem(stateKey, JSON.stringify(savedState));
          setStatus(result.message || 'Your previous code expired. Confirm your details to request one fresh code.', 'error');
        } else {
          setStatus('Confirm your details to begin registration.', '');
        }
      } catch (error) {
        setStatus(publicErrorMessage(error, 'We could not reach Bob to check your registration. You can still confirm your details below, or try again in a moment.'), 'error');
      } finally {
        setBusy(false, 'details');
      }
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      setStatus('', '');
      if (currentStep === 'details') requestCode();
      else if (currentStep === 'verify') verifyCode();
    });

    sendAgain.addEventListener('click', function () {
      if (sendAgain.disabled) return;
      if (resumeNeedsDetails) {
        challengeId = '';
        resumeNeedsDetails = false;
        showStep('details');
        setStatus('Confirm your details to request one fresh code.', 'error');
        return;
      }
      requestCode();
    });

    needHelp.addEventListener('click', requestHelp);

    if (/^[A-Za-z0-9_-]{40,200}$/.test(inviteToken)) {
      if (savedState.name) form.elements.name.value = savedState.name;
      if (savedState.email) form.elements.email.value = savedState.email;
      if (savedState.phone) form.elements.phone.value = savedState.phone;
      if (savedState.wants_sms) form.elements.sms_agree.checked = true;
      resumeRegistration();
    }
  })();
</script>

