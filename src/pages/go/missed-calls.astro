---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FitDiagnostic from '../../components/FitDiagnostic.astro';

// MISSED-CALLS advertorial arm — /go/missed-calls (Format 2, paid-traffic LP lock)
// Angle: problem-aware owner; the story of the calls nobody answered. Lands FB angles
//        a06 (week framing) + a07 (missed-call math) from batch 2026-07-niche-intel-bwm-angle-bank.
// Register: status-quo tax + identity transformation (overwhelmed -> in-control) ·
//           proof-before-CTA · soft RLM conversion (scroll_depth is the primary target).
// Copy approved by Robert 2026-07-13 (brief: brand/campaigns/BWM-Niche-Intel-FB-Campaign-Brief-2026-07.md).
// UTM contract: utm_content=go-missed-calls
---

<BaseLayout
  title="The Real Cost of the Calls Your Office Misses | Buildwise Media"
  description="It is not the phone bill. It is the jobs that quietly go to someone else. See what missed calls cost a service business — and the system that answers every one."
  ogTitle="The real cost of the calls your office misses"
  ogDescription="One missed emergency call can be a four-figure job. See what your business leaks — free."
  noindex={true}
>

  <!-- HERO ─────────────────────────────────────────────────────────────── -->
  <section class="mc-hero" aria-labelledby="mc-hero-headline">
    <div class="container">
      <p class="eyebrow">Buildwise Media · For service-business owners</p>

      <!-- @bwm-exp-slot: hero-headline — advertorial hook H1; problem-framing vs cost-framing arms test here -->
      <h1 id="mc-hero-headline" class="mc-headline" data-bwm-exp-slot="hero-headline">
        The real cost of the calls<br />your office <span class="mc-accent">misses</span>.
      </h1>

      <p class="mc-deck">It is not the phone bill. It is the jobs that quietly go to someone else.</p>
    </div>
  </section>

  <!-- STORY ────────────────────────────────────────────────────────────── -->
  <section class="mc-story" aria-label="The missed-call story">
    <div class="container mc-prose">
      <p class="mc-lead">
        You were on a roof, or under a sink, or just at dinner. The phone rang. Nobody answered.
        That happens at every service business, every week.
      </p>

      <p>
        Here is the part nobody sees: the caller does not leave a voicemail. They call the next
        company on the list. One missed emergency call can be a four-figure job. A season of them
        can be the difference between a growth year and a flat one.
      </p>

      <!-- bwm-creative-kit:processflow — edit data inline; regenerate: see kit/generate.py -->
      <!-- @r020:F2 proof: the leak path rendered as a flow diagram — the visual shows the status-quo tax (the job books, just not with you) without a single adjective -->
      <figure class="bwm-kit bwm-kit-processflow" style="margin:28px 0;max-width:720px">
        <svg viewBox="0 0 640 250" width="100%" role="img" aria-label="Where a missed call goes">
          <text x="30" y="34" font-size="17" font-weight="700" style="font-family:inherit" fill="#EDEDF0">Where a missed call goes</text>
          <circle cx="102" cy="130" r="26" fill="none" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="102" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#F0FF00">1</text>
          <text x="102" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Your phone rings</text>
          <line x1="128" y1="130" x2="214" y2="130" stroke="#62626A" stroke-width="2"/>
          <path d="M216 130 l-10 -6 v12 z" fill="#62626A"/>
          <circle cx="248" cy="130" r="26" fill="none" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="248" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#F0FF00">2</text>
          <text x="248" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Nobody answers</text>
          <line x1="274" y1="130" x2="358" y2="130" stroke="#62626A" stroke-width="2"/>
          <path d="M360 130 l-10 -6 v12 z" fill="#62626A"/>
          <circle cx="392" cy="130" r="26" fill="none" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="392" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#F0FF00">3</text>
          <text x="392" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">They call the next shop</text>
          <line x1="418" y1="130" x2="504" y2="130" stroke="#62626A" stroke-width="2"/>
          <path d="M506 130 l-10 -6 v12 z" fill="#62626A"/>
          <circle cx="538" cy="130" r="26" fill="none" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="538" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#F0FF00">4</text>
          <text x="538" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Booked — by them</text>
        </svg>
      </figure>

      <h2 class="mc-h2">Why good businesses miss calls</h2>
      <p>
        Calls get missed for boring reasons. Everyone is on a job. It is after hours. The office
        is at lunch. None of that means your business is broken — it means your phone works harder
        than your staffing plan.
      </p>
      <p>
        Fixing it used to mean hiring more office staff. Or paying an answering service that reads
        a script, takes a message, and leaves the follow-up to whoever remembers.
      </p>
    </div>
  </section>

  <!-- LEAK MATH — interactive proof ────────────────────────────────────── -->
  <section class="mc-math" aria-labelledby="mc-math-heading">
    <!-- @sdt-interactive-proof: missed-call leak math — three sliders (missed calls/week,
         average job value, close rate) drive a live yearly-leak figure; the reader's own
         numbers make the status-quo tax concrete. Gesture-driven only (R017). -->
    <div class="container">
      <p class="section-tag">LEAK MATH · DRAG THE SLIDERS</p>
      <h2 id="mc-math-heading" class="h-section">What do missed calls cost <em>your</em> business?</h2>
      <p class="lede">Use your own numbers. This is an estimate — the Revenue Leak Map measures the real thing.</p>

      <div class="mc-calc" id="mc-calc">
        <div class="mc-calc-inputs">
          <label class="mc-slider">
            <span class="mono">Missed calls per week</span>
            <input type="range" id="mc-calls" min="1" max="15" step="1" value="3" />
            <output for="mc-calls" id="mc-calls-out">3</output>
          </label>
          <label class="mc-slider">
            <span class="mono">Average job value</span>
            <input type="range" id="mc-value" min="200" max="5000" step="100" value="800" />
            <output for="mc-value" id="mc-value-out">$800</output>
          </label>
          <label class="mc-slider">
            <span class="mono">Close rate when you DO answer</span>
            <input type="range" id="mc-close" min="10" max="60" step="5" value="30" />
            <output for="mc-close" id="mc-close-out">30%</output>
          </label>
        </div>
        <div class="mc-calc-result">
          <p class="mono">ESTIMATED YEARLY LEAK</p>
          <p class="mc-calc-figure" id="mc-leak" aria-live="polite">$37,440</p>
          <p class="mc-calc-note">missed calls × 52 weeks × your close rate × your average job</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE THIRD WAY ────────────────────────────────────────────────────── -->
  <section class="mc-resolve" aria-labelledby="mc-resolve-heading">
    <div class="container mc-prose">
      <h2 id="mc-resolve-heading" class="mc-h2">There is a third way now</h2>
      <p>
        A custom AI system that answers in seconds, books the job on your real calendar, texts
        back every missed call, and chases every open quote. Not a tool you have to run. A system
        our team builds around your business — and keeps running for you.
      </p>
      <p>
        Your customers notice nothing except that someone always picks up. You notice the calendar.
      </p>

      <!-- bwm-creative-kit:processflow — regenerate: see kit/generate.py -->
      <!-- @r020:F3 CTA-pull: the answered-path mirror of the leak diagram — same grammar, the job books with YOU; pulls the reader toward wanting this path (the Leak Map CTA follows) -->
      <figure class="bwm-kit bwm-kit-processflow" style="margin:28px 0;max-width:720px">
        <svg viewBox="0 0 640 250" width="100%" role="img" aria-label="The same call, with the system answering">
          <text x="30" y="34" font-size="17" font-weight="700" style="font-family:inherit" fill="#EDEDF0">The same call, with the system</text>
          <circle cx="102" cy="130" r="26" fill="none" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="102" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#F0FF00">1</text>
          <text x="102" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Your phone rings</text>
          <line x1="128" y1="130" x2="214" y2="130" stroke="#62626A" stroke-width="2"/>
          <path d="M216 130 l-10 -6 v12 z" fill="#62626A"/>
          <circle cx="248" cy="130" r="26" fill="#F0FF00" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="248" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#050507">2</text>
          <text x="248" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Answered in seconds</text>
          <line x1="274" y1="130" x2="358" y2="130" stroke="#62626A" stroke-width="2"/>
          <path d="M360 130 l-10 -6 v12 z" fill="#62626A"/>
          <circle cx="392" cy="130" r="26" fill="#F0FF00" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="392" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#050507">3</text>
          <text x="392" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Booked on your calendar</text>
          <line x1="418" y1="130" x2="504" y2="130" stroke="#62626A" stroke-width="2"/>
          <path d="M506 130 l-10 -6 v12 z" fill="#62626A"/>
          <circle cx="538" cy="130" r="26" fill="#F0FF00" stroke="#F0FF00" stroke-width="2.5"/>
          <text x="538" y="136" font-size="16" font-weight="800" text-anchor="middle" style="font-family:inherit" fill="#050507">4</text>
          <text x="538" y="182" font-size="12.5" text-anchor="middle" style="font-family:inherit" fill="#9B9B9B">Followed up — by you</text>
        </svg>
      </figure>
    </div>
  </section>

  <!-- PROOF ────────────────────────────────────────────────────────────── -->
  <section class="mc-proof" aria-labelledby="mc-proof-heading" data-bwm-exp-slot="proof-module">
    <!-- @bwm-exp-slot: proof-module — measured-register proof strip preceding the soft CTA (proof-before-CTA rule) -->
    <div class="container">
      <p class="section-tag">MEASURED, NOT PROMISED</p>
      <h2 id="mc-proof-heading" class="h-section">Every number we report is measured.</h2>
      <div class="mc-proof-grid">
        <!-- @r020:F2 proof: mono numerals in the measured register — the data itself is the image; shows the system reports real counts, not adjectives -->
        <div class="mc-proof-item">
          <p class="mono">WHAT CLIENTS WATCH</p>
          <p class="mc-proof-line">Calls answered · jobs booked · quotes revived · reviews earned</p>
          <p class="mc-proof-body">Plain-English updates from the system, every week. You see what it did, not what was planned.</p>
        </div>
        <div class="mc-proof-item">
          <p class="mono">ONE CLIENT'S PATH</p>
          <p class="mc-proof-line">$300K &rarr; over $10M</p>
          <p class="mc-proof-body">Growth with a system behind them — measured from their own numbers, start to finish.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOFT CTA ─────────────────────────────────────────────────────────── -->
  <section class="mc-cta" aria-labelledby="mc-cta-heading">
    <div class="container">
      <h2 id="mc-cta-heading" class="h-section">Want to know what your business leaks right now?</h2>
      <p class="lede">
        We will map it for you — missed calls, dead quotes, invisible listings — free.
        Five minutes. No pitch.
      </p>
      <!-- @bwm-exp-slot: hero-cta — the advertorial's soft conversion block (RLM) -->
      <div class="mc-cta-row" data-bwm-exp-slot="hero-cta">
        <a href="#diagnostic" class="cta" data-cta-source="f2-missed-calls-inline">
          Get My Free Revenue Leak Map
          <span class="cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/book" class="cta-ghost" data-cta-source="f2-missed-calls-final">See If We're a Fit</a>
      </div>
    </div>
  </section>

  <!-- REVENUE LEAK MAP DIAGNOSTIC — conversion endpoint -->
  <FitDiagnostic />

</BaseLayout>

<style>
/* ─── HERO ─────────────────────────────────────────────────────────────── */
.mc-hero {
  padding-top: clamp(96px, 11vw, 168px);
  padding-bottom: clamp(40px, 5vw, 72px);
  background: var(--bg);
}
.mc-headline {
  font-weight: 800;
  font-size: clamp(34px, 6vw, 64px);
  line-height: 1.04;
  letter-spacing: -0.02em;
  margin-top: 16px;
}
.mc-accent { color: var(--y2); }
.mc-deck {
  margin-top: 18px;
  font-size: clamp(17px, 2vw, 21px);
  color: var(--ink-dim);
  max-width: 560px;
}

/* ─── STORY / PROSE ────────────────────────────────────────────────────── */
.mc-story, .mc-resolve { padding: clamp(40px, 5vw, 72px) 0; }
.mc-prose { max-width: 680px; }
.mc-prose p { margin: 0 0 20px; font-size: clamp(16px, 1.8vw, 18px); line-height: 1.65; color: var(--ink); }
.mc-lead { font-size: clamp(18px, 2.2vw, 22px) !important; }
.mc-h2 {
  font-weight: 700;
  font-size: clamp(22px, 3vw, 30px);
  letter-spacing: -0.01em;
  margin: 36px 0 14px;
}

/* ─── LEAK MATH ────────────────────────────────────────────────────────── */
.mc-math { padding: clamp(48px, 6vw, 88px) 0; background: var(--bg-elev); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
.mc-calc {
  margin-top: 32px;
  display: grid;
  gap: clamp(24px, 4vw, 48px);
  grid-template-columns: 1fr;
}
@media (min-width: 860px) { .mc-calc { grid-template-columns: 1.1fr 0.9fr; align-items: center; } }
.mc-calc-inputs { display: grid; gap: 22px; }
.mc-slider { display: grid; gap: 8px; }
.mc-slider span { font-size: 11px; letter-spacing: 0.08em; color: var(--ink-dim); }
.mc-slider input[type="range"] { width: 100%; accent-color: var(--y2); }
.mc-slider output { font-family: 'JetBrains Mono', monospace; font-size: 18px; color: var(--ink); }
.mc-calc-result {
  border: 1px solid var(--rule-bright);
  background: var(--bg-card);
  padding: clamp(24px, 3vw, 36px);
  text-align: center;
}
.mc-calc-result .mono { color: var(--ink-dim); font-size: 11px; letter-spacing: 0.1em; }
.mc-calc-figure {
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  font-size: clamp(36px, 5vw, 56px);
  color: var(--y2);
  margin: 10px 0 6px;
}
.mc-calc-note { font-size: 12px; color: var(--ink-faint); }

/* ─── PROOF ────────────────────────────────────────────────────────────── */
.mc-proof { padding: clamp(48px, 6vw, 88px) 0; }
.mc-proof-grid {
  margin-top: 28px;
  display: grid;
  gap: 16px;
  grid-template-columns: 1fr;
}
@media (min-width: 760px) { .mc-proof-grid { grid-template-columns: 1fr 1fr; } }
.mc-proof-item { border: 1px solid var(--rule); padding: 24px; background: var(--bg-elev); }
.mc-proof-item .mono { font-size: 10px; letter-spacing: 0.1em; color: var(--ink-dim); }
.mc-proof-line {
  font-family: 'JetBrains Mono', monospace;
  font-size: clamp(18px, 2.4vw, 24px);
  color: var(--ink);
  margin: 10px 0 8px;
}
.mc-proof-body { font-size: 14px; color: var(--ink-dim); line-height: 1.55; }

/* ─── CTA ──────────────────────────────────────────────────────────────── */
.mc-cta { padding: clamp(48px, 6vw, 88px) 0; border-top: 1px solid var(--rule); }
.mc-cta-row { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
</style>

<script>
  // Leak-math widget — gesture-driven only (R017 interactive-proof register).
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const fmt = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
  function recalc() {
    const calls = Number($('mc-calls').value);
    const value = Number($('mc-value').value);
    const close = Number($('mc-close').value);
    $('mc-calls-out').textContent = String(calls);
    $('mc-value-out').textContent = fmt(value);
    $('mc-close-out').textContent = close + '%';
    $('mc-leak').textContent = fmt(calls * 52 * (close / 100) * value);
  }
  ['mc-calls', 'mc-value', 'mc-close'].forEach((id) =>
    $(id).addEventListener('input', recalc)
  );
  recalc();
</script>
