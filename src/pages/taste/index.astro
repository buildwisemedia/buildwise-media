---
import BaseLayout from '../../layouts/BaseLayout.astro';

const shared = {
  eyebrow: 'CUSTOM AI SYSTEMS FOR OWNER-LED BUSINESSES',
  headline: 'Where does the work keep getting stuck?',
  answer: 'We build the AI system for that.',
  support: 'Requests wait. Decisions stall. Important context lives in too many places. You pick one problem. In 90 days, we build and test a custom AI system around it.',
};

const copyCandidates = [
  {
    id: 'A',
    eyebrow: 'Custom AI for owner-led service businesses',
    headline: 'Pick one problem that keeps work stuck. We build the system around it.',
    support: 'Buildwise Media builds custom AI systems for owner-led service businesses. Maybe requests wait for the right person. Maybe decisions wait for missing context. Maybe someone rebuilds a status by hand. You choose one problem. We build, connect, and test a system around it.',
    mechanismTitle: 'How the 90-day Pilot works',
    steps: ['You pick one problem', 'We build, connect, test', 'We review real work together'],
    fitTitle: 'Is this a fit for your business?',
    fitSupport: "The Pilot runs 90 days and costs $15,000 up front. We don't promise a business result. You see how it handles real work, then decide what's next.",
  },
  {
    id: 'B',
    eyebrow: 'AI systems for owner-led service businesses',
    headline: 'We build one custom AI system for work that keeps getting stuck.',
    support: 'Maybe requests wait for the right person. Maybe decisions wait for missing context. Maybe a status gets rebuilt by hand. You pick one problem like these. Buildwise builds and tests a custom system around it.',
    mechanismTitle: 'How the 90-day Pilot works',
    steps: ['You pick one problem', 'We build, connect, and test', 'We review real work together'],
    fitTitle: 'Is Buildwise a fit for you?',
    fitSupport: "The Pilot runs 90 days and costs $15,000, paid up front. We review what happened with real work, together. No business result is promised. You decide if that's right.",
  },
  {
    id: 'C',
    eyebrow: 'Custom AI systems for service businesses',
    headline: 'Your business should not have to relearn the same work every day.',
    support: 'A request waits for the right person. A decision stalls because context is missing. A status gets rebuilt by hand. Choose one problem. Buildwise builds and tests a custom AI system around it in a 90-day Pilot.',
    mechanismTitle: 'From stuck work to a real test',
    steps: ['Name the stuck work', 'Build the system', 'Test it together'],
    fitTitle: 'Start with the problem worth fixing first',
    fitSupport: 'The Pilot costs $15,000 up front. It runs for 90 days. You review what happened with real work. No business result is promised.',
  },
];

const refineHeroCandidates = [
  {
    id: 'A',
    eyebrow: 'Custom AI systems for owner-led service businesses',
    headline: 'One stuck problem. One custom AI system. Tested in 90 days.',
    support: 'You pick the operational problem. Buildwise builds one custom AI system around it and tests it with real work during the 90-day Pilot.',
  },
  {
    id: 'B',
    eyebrow: 'Custom AI for owner-led service businesses',
    headline: 'Pick one stuck problem. We build the custom AI system.',
    support: 'You choose one operational problem. Buildwise builds, connects, and tests a custom AI system around it with real work during a 90-day Pilot.',
  },
  {
    id: 'C',
    eyebrow: 'Custom AI systems',
    headline: 'We build one AI system around your stuck problem.',
    support: 'You pick one operational problem. We build, connect, and test one custom AI system around it and your real work in 90 days.',
  },
];

const refineBlueCandidates = [
  {
    id: 'A',
    kicker: 'Review and decide',
    headline: 'Review the work. Decide next steps.',
    support: 'We review what happened together. Then you decide what to do next.',
  },
  {
    id: 'B',
    kicker: 'The decision stays with you',
    headline: 'Review the real work. Decide what comes next.',
    support: 'At the end, you review what the system did with your work. Then you decide the next step.',
  },
  {
    id: 'C',
    kicker: 'After the test',
    headline: 'See what happened. Choose what comes next.',
    support: 'We review what the system did with real work. You decide what comes next.',
  },
];

const lockedMechanism = [
  'You pick one problem',
  'We build, connect, and test',
  'We review real work together',
];

const resetCandidates = [
  {
    id: 'A',
    eyebrow: 'A long-term AI systems partner',
    headline: 'Custom AI systems built around your business.',
    support: 'We learn how your work moves, build the right systems with you, and improve them as your team and needs change. The relationship begins with one important problem.',
    growthHeadline: 'One business. A growing system.',
    steps: ['Start with the biggest need', 'Build around real work', 'Add what comes next'],
    pilotLine: 'Start with one system in a 90-day Pilot.',
    blueKicker: 'Built for the long run',
    blueHeadline: 'Not one fix. A better way to build.',
    blueSupport: 'Keep building with us when it helps. Stop when it doesn’t. You own the system, the data, and the code we built together.',
  },
  {
    id: 'B',
    eyebrow: 'Built to keep building',
    headline: 'Your business keeps changing. Your systems should keep up.',
    support: 'Buildwise builds custom AI systems for owner-led service businesses—and keeps improving them as real work teaches us what to build next.',
    growthHeadline: 'One system first. More as you grow.',
    steps: ['Pick one problem that matters', 'We build and test it', 'Keep improving. Add more later.'],
    pilotLine: 'The 90-day, $15,000 Pilot is how we start—one problem.',
    blueKicker: 'The long game',
    blueHeadline: 'Your business will change. Your systems can too.',
    blueSupport: 'You own the system, the data, and the code. Run it yourself, or keep building with us as new needs come up.',
  },
  {
    id: 'C',
    eyebrow: 'Custom AI systems for owner-led service businesses',
    headline: 'Build the systems your business needs next.',
    support: 'Buildwise works with you to build and improve custom AI systems across the business. We start with one important problem, learn from real work, and keep building from there.',
    growthHeadline: 'Start focused. Build from what works.',
    steps: ['Choose the first priority', 'Test it in real work', 'Improve and expand'],
    pilotLine: 'The 90-day Pilot is the first build, not the finish line.',
    blueKicker: 'After the first system',
    blueHeadline: 'Keep building as your business changes.',
    blueSupport: 'Improve the first system. Connect the next one. Or take what you own and run it yourself. The next step stays yours.',
  },
];

const synthYellowHeadings = [
  { id: 'A', text: 'How your business becomes AI-native.' },
  { id: 'B', text: 'Build an AI-native business.' },
  { id: 'C', text: 'From one problem to an AI-native business.' },
];

const synthBlueHeadings = [
  { id: 'A', text: 'Keep building toward an AI-native business.' },
  { id: 'B', text: 'Buildwise keeps building with you.' },
  { id: 'C', text: 'AI becomes part of how the business works.' },
];

const synthSteps = [
  'Pick one problem that matters',
  'We build and test it',
  'Keep improving across the business',
];
---

<BaseLayout
  title="BWM Homepage Blind Taste Lab"
  description="Private anonymous homepage direction test."
  noindex
  focusedLandingPage
  privacySensitive
>
  <div class="taste-lab">
    <header class="lab-header">
      <a class="lab-mark" href="/taste/" aria-label="Return to the blind test start">BUILDWISE <span>MEDIA</span></a>
      <p>BLIND HOMEPAGE TEST</p>
      <nav aria-label="Blind test rounds">
        <button class="round-tab is-active" type="button" data-round-target="visual">01 · VISUAL</button>
        <button class="round-tab" type="button" data-round-target="copy">02 · WORDS</button>
        <button class="round-tab" type="button" data-round-target="refine">03 · REFINE</button>
        <button class="round-tab" type="button" data-round-target="reset">04 · RESET</button>
        <button class="round-tab" type="button" data-round-target="synth">05 · SYNTH</button>
      </nav>
    </header>

    <div class="lab-main">
      <section class="test-round is-active" data-round="visual" aria-labelledby="visual-round-title">
        <div class="round-intro">
          <p>ROUND 01</p>
          <h1 id="visual-round-title">Same words. Four structures.</h1>
        </div>

        <div class="candidate-switcher" role="tablist" aria-label="Visual candidates">
          {['A', 'B', 'C', 'D'].map((id, index) => (
            <button
              class:list={['candidate-tab', { 'is-active': index === 0 }]}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              data-candidate-target={id}
            >{id}</button>
          ))}
        </div>

        <div class="visual-stage">
          <article class="visual-candidate visual-a is-active" data-candidate="A" aria-label="Visual candidate A">
            <div class="candidate-letter">A</div>
            <div class="va-shell">
              <div class="va-copy">
                <p class="v-eyebrow">{shared.eyebrow}</p>
                <h2>{shared.headline}<span>{shared.answer}</span></h2>
                <p class="v-support">{shared.support}</p>
                <div class="v-actions"><span>See If We're a Fit</span><b>See the System ↓</b></div>
                <ul class="v-facts"><li><strong>1</strong> problem</li><li><strong>90</strong> days</li><li><strong>$15K</strong> up front</li></ul>
              </div>
              <!-- @r020:F2 proof: semantic process stack explains problem to build to review. -->
              <div class="va-system" role="img" aria-label="Work moves from stuck, through a custom AI system, to a real review">
                <p>ONE PROBLEM · ONE SYSTEM · ONE REAL TEST</p>
                <div class="va-step va-step--orange"><small>YOUR TEAM BRINGS</small><strong>Work that keeps getting stuck</strong></div>
                <b aria-hidden="true">↓</b>
                <div class="va-step va-step--dark"><small>BUILDWISE BUILDS</small><strong>A custom AI system</strong></div>
                <b aria-hidden="true">↓</b>
                <div class="va-step va-step--green"><small>YOU BOTH REVIEW</small><strong>What happened with real work</strong></div>
              </div>
            </div>
          </article>

          <article class="visual-candidate visual-b" data-candidate="B" aria-label="Visual candidate B" hidden>
            <div class="candidate-letter">B</div>
            <div class="vb-shell">
              <p class="v-eyebrow">{shared.eyebrow}</p>
              <h2>{shared.headline}</h2>
              <p class="vb-answer">{shared.answer}</p>
              <p class="v-support">{shared.support}</p>
              <div class="v-actions"><span>See If We're a Fit</span><b>See the System ↓</b></div>
              <!-- @r020:F2 proof: oversized numbered path makes the 90-day sequence legible without prose. -->
              <ol class="vb-path" aria-label="Pilot path">
                <li><strong>1</strong><span>CHOOSE<br /><b>One problem</b></span></li>
                <li><strong>2</strong><span>BUILD<br /><b>One system</b></span></li>
                <li><strong>3</strong><span>REVIEW<br /><b>Real work</b></span></li>
              </ol>
              <ul class="v-facts"><li><strong>1</strong> problem</li><li><strong>90</strong> days</li><li><strong>$15K</strong> up front</li></ul>
            </div>
          </article>

          <article class="visual-candidate visual-c" data-candidate="C" aria-label="Visual candidate C" hidden>
            <div class="candidate-letter">C</div>
            <div class="vc-shell">
              <div class="vc-top">
                <p class="v-eyebrow">{shared.eyebrow}</p>
                <span>ONE PROBLEM</span>
              </div>
              <div class="vc-main">
                <div class="vc-one">1</div>
                <div class="vc-copy">
                  <h2>{shared.headline}<span>{shared.answer}</span></h2>
                  <p class="v-support">{shared.support}</p>
                  <div class="v-actions"><span>See If We're a Fit</span><b>See the System ↓</b></div>
                </div>
              </div>
              <!-- @r020:F2 proof: connected operating tiles show the human-controlled build sequence. -->
              <div class="vc-rail" role="img" aria-label="Choose, build, and review sequence">
                <div><small>01 · CHOOSE</small><strong>Point to the stuck work.</strong></div>
                <div><small>02 · BUILD</small><strong>Connect the right system.</strong></div>
                <div><small>03 · REVIEW</small><strong>Test it with real work.</strong></div>
              </div>
              <ul class="v-facts"><li><strong>1</strong> problem</li><li><strong>90</strong> days</li><li><strong>$15K</strong> up front</li></ul>
            </div>
          </article>

          <article class="visual-candidate visual-d" data-candidate="D" aria-label="Visual candidate D" hidden>
            <div class="candidate-letter">D</div>
            <div class="vd-shell">
              <div class="vd-banner">
                <p class="v-eyebrow">{shared.eyebrow}</p>
                <h2>{shared.headline}</h2>
              </div>
              <div class="vd-lower">
                <div class="vd-copy">
                  <p class="vd-answer">{shared.answer}</p>
                  <p class="v-support">{shared.support}</p>
                  <div class="v-actions"><span>See If We're a Fit</span><b>See the System ↓</b></div>
                  <ul class="v-facts"><li><strong>1</strong> problem</li><li><strong>90</strong> days</li><li><strong>$15K</strong> up front</li></ul>
                </div>
                <!-- @r020:F2 proof: three vertical tracks compare the before, build, and review states. -->
                <div class="vd-tracks" role="img" aria-label="Three-part Pilot sequence">
                  <div><small>BEFORE</small><b>Work waits</b><span>01</span></div>
                  <div><small>BUILD</small><b>System works</b><span>02</span></div>
                  <div><small>REVIEW</small><b>You decide</b><span>03</span></div>
                </div>
              </div>
            </div>
          </article>
        </div>
        <p class="response-cue">Pick a letter. Then tell me what pulled you in—and what pushed you away.</p>
      </section>

      <section class="test-round" data-round="copy" aria-labelledby="copy-round-title" hidden>
        <div class="round-intro">
          <p>ROUND 02</p>
          <h1 id="copy-round-title">Same layout. Three voices.</h1>
        </div>
        <div class="candidate-switcher" role="tablist" aria-label="Copy candidates">
          {copyCandidates.map((candidate, index) => (
            <button
              class:list={['candidate-tab', { 'is-active': index === 0 }]}
              type="button"
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
              data-copy-target={candidate.id}
            >{candidate.id}</button>
          ))}
        </div>

        <div class="copy-stage">
          {copyCandidates.map((candidate, index) => (
            <article class:list={['copy-candidate', { 'is-active': index === 0 }]} data-copy={candidate.id} hidden={index !== 0} aria-label={`Copy candidate ${candidate.id}`}>
              <div class="candidate-letter candidate-letter--copy">{candidate.id}</div>
              <div class="copy-hero">
                <p class="copy-eyebrow">{candidate.eyebrow}</p>
                <h2>{candidate.headline}</h2>
                <p>{candidate.support}</p>
                <span class="copy-cta">See If We're a Fit</span>
              </div>
              <div class="copy-mechanism">
                <h3>{candidate.mechanismTitle}</h3>
                <ol>{candidate.steps.map((step, stepIndex) => <li><b>{stepIndex + 1}</b><span>{step}</span></li>)}</ol>
              </div>
              <div class="copy-fit">
                <h3>{candidate.fitTitle}</h3>
                <p>{candidate.fitSupport}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="response-cue">Pick a letter. Tell me the line you would keep and the line you would kill.</p>
      </section>

      <section class="test-round" data-round="refine" aria-labelledby="refine-round-title" hidden>
        <div class="round-intro round-intro--refine">
          <p>ROUND 03</p>
          <h1 id="refine-round-title">Tighter hero. New final section.</h1>
        </div>

        <section class="refine-test" aria-labelledby="refine-hero-title">
          <div class="refine-heading">
            <div>
              <p>03A · HERO</p>
              <h2 id="refine-hero-title">Same meaning. Less copy.</h2>
            </div>
            <div class="candidate-switcher" role="tablist" aria-label="Refined hero candidates">
              {refineHeroCandidates.map((candidate, index) => (
                <button
                  class:list={['candidate-tab', { 'is-active': index === 0 }]}
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  data-refine-hero-target={candidate.id}
                >{candidate.id}</button>
              ))}
            </div>
          </div>

          <div class="refine-hero-stage">
            {refineHeroCandidates.map((candidate, index) => (
              <article class:list={['refine-hero-candidate', { 'is-active': index === 0 }]} data-refine-hero={candidate.id} hidden={index !== 0} aria-label={`Refined hero candidate ${candidate.id}`}>
                <div class="candidate-letter">{candidate.id}</div>
                <div class="refine-hero-copy">
                  <p>{candidate.eyebrow}</p>
                  <h3>{candidate.headline}</h3>
                  <p>{candidate.support}</p>
                  <span>See If We're a Fit</span>
                </div>
                <!-- @r020:F2 proof: the locked three-step mechanism keeps the concise hero grounded in the actual Pilot. -->
                <div class="refine-mechanism" role="img" aria-label="The locked 90-day Pilot sequence">
                  <p>How the 90-day Pilot works</p>
                  <ol>{lockedMechanism.map((step, stepIndex) => <li><b>{stepIndex + 1}</b><span>{step}</span></li>)}</ol>
                </div>
              </article>
            ))}
          </div>
          <p class="response-cue">Pick the hero letter that keeps the accuracy without feeling long.</p>
        </section>

        <section class="refine-test refine-test--blue" aria-labelledby="refine-blue-title">
          <div class="refine-heading">
            <div>
              <p>03B · BLUE</p>
              <h2 id="refine-blue-title">A new job for this section.</h2>
            </div>
            <div class="candidate-switcher" role="tablist" aria-label="Blue section candidates">
              {refineBlueCandidates.map((candidate, index) => (
                <button
                  class:list={['candidate-tab', { 'is-active': index === 0 }]}
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  data-refine-blue-target={candidate.id}
                >{candidate.id}</button>
              ))}
            </div>
          </div>

          <div class="refine-blue-stage">
            {refineBlueCandidates.map((candidate, index) => (
              <article class:list={['refine-blue-candidate', { 'is-active': index === 0 }]} data-refine-blue={candidate.id} hidden={index !== 0} aria-label={`Blue section candidate ${candidate.id}`}>
                <div class="candidate-letter candidate-letter--blue">{candidate.id}</div>
                <p>{candidate.kicker}</p>
                <h3>{candidate.headline}</h3>
                <p>{candidate.support}</p>
              </article>
            ))}
          </div>
          <p class="response-cue">Pick the blue letter—or reject all three again.</p>
        </section>
      </section>

      <section class="test-round" data-round="reset" aria-labelledby="reset-round-title" hidden>
        <div class="round-intro round-intro--reset">
          <div>
            <p>ROUND 04 · POSITIONING RESET</p>
            <h1 id="reset-round-title">The company first. The Pilot second.</h1>
          </div>
          <div class="candidate-switcher" role="tablist" aria-label="Company-first positioning candidates">
            {resetCandidates.map((candidate, index) => (
              <button
                class:list={['candidate-tab', { 'is-active': index === 0 }]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                data-reset-target={candidate.id}
              >{candidate.id}</button>
            ))}
          </div>
        </div>

        <div class="reset-stage">
          {resetCandidates.map((candidate, index) => (
            <article class:list={['reset-candidate', { 'is-active': index === 0 }]} data-reset={candidate.id} hidden={index !== 0} aria-label={`Company-first candidate ${candidate.id}`}>
              <div class="candidate-letter">{candidate.id}</div>
              <section class="reset-hero">
                <div>
                  <p>{candidate.eyebrow}</p>
                  <h2>{candidate.headline}</h2>
                  <p>{candidate.support}</p>
                  <span>See If We're a Fit</span>
                </div>
                <div class="reset-relationship" role="img" aria-label="Buildwise relationship expands from the first system into ongoing improvement">
                  <small>THE RELATIONSHIP</small>
                  <b>FIRST<br />SYSTEM</b>
                  <i aria-hidden="true">→</i>
                  <b>IMPROVE<br />TOGETHER</b>
                  <i aria-hidden="true">→</i>
                  <b>BUILD<br />WHAT'S NEXT</b>
                </div>
              </section>

              <!-- @r020:F2 proof: the growth path separates the first Pilot from the longer Buildwise relationship. -->
              <section class="reset-growth">
                <p>HOW THE WORK GROWS</p>
                <h3>{candidate.growthHeadline}</h3>
                <ol>{candidate.steps.map((step, stepIndex) => <li><b>{stepIndex + 1}</b><span>{step}</span></li>)}</ol>
              </section>

              <aside class="reset-pilot" aria-label="Pilot entry offer">
                <small>THE WAY IN</small>
                <strong>{candidate.pilotLine}</strong>
              </aside>

              <section class="reset-blue">
                <p>{candidate.blueKicker}</p>
                <h3>{candidate.blueHeadline}</h3>
                <p>{candidate.blueSupport}</p>
              </section>
            </article>
          ))}
        </div>
        <p class="response-cue">Pick the version that makes Buildwise feel like the right long-term partner—not a one-project shop.</p>
      </section>

      <section class="test-round" data-round="synth" aria-labelledby="synth-round-title" hidden>
        <div class="round-intro round-intro--synth">
          <div>
            <p>ROUND 05 · TRIANGULATION</p>
            <h1 id="synth-round-title">One direction. Two final language choices.</h1>
          </div>
          <span>Built from your Round 4 feedback</span>
        </div>

        <article class="synth-stage">
          <section class="synth-hero">
            <div class="synth-hero-copy">
              <p>Custom AI systems</p>
              <h2>Build the systems your business needs next.</h2>
              <p>Buildwise works with you to build and improve custom AI systems across the business. We start with one important problem, learn from real work, and keep building from there.</p>
              <span>See If We're a Fit</span>
            </div>
            <!-- @r020:F2 proof: the relationship diagram makes the one-problem entry visibly subordinate to the AI-native business arc. -->
            <div class="synth-arc" role="img" aria-label="Buildwise starts with one problem and keeps building toward an AI-native business">
              <small>THE BUILDWISE RELATIONSHIP</small>
              <div><b>01</b><span>ONE PROBLEM<br />THAT MATTERS</span></div>
              <i aria-hidden="true">↓</i>
              <div><b>02</b><span>KEEP BUILDING<br />+ IMPROVING</span></div>
              <i aria-hidden="true">↓</i>
              <div><b>03</b><span>AI-NATIVE<br />BUSINESS</span></div>
            </div>
          </section>

          <section class="synth-yellow" aria-labelledby="synth-yellow-title">
            <div class="synth-choice-header">
              <div>
                <p>YELLOW · CHOOSE A HEADING</p>
                <span>Everything else here is locked.</span>
              </div>
              <div class="candidate-switcher" role="tablist" aria-label="Yellow heading choices">
                {synthYellowHeadings.map((candidate, index) => (
                  <button
                    class:list={['candidate-tab', { 'is-active': index === 0 }]}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    data-synth-yellow-target={candidate.id}
                  >{candidate.id}</button>
                ))}
              </div>
            </div>
            <div class="synth-heading-stack">
              {synthYellowHeadings.map((candidate, index) => (
                <h3 id={index === 0 ? 'synth-yellow-title' : undefined} data-synth-yellow={candidate.id} hidden={index !== 0}>{candidate.text}</h3>
              ))}
            </div>
            <ol>{synthSteps.map((step, stepIndex) => <li><b>{stepIndex + 1}</b><span>{step}</span></li>)}</ol>
          </section>

          <aside class="synth-pilot">
            <small>THE WAY IN</small>
            <strong>The 90-day Pilot is where we begin.</strong>
          </aside>

          <section class="synth-blue" aria-labelledby="synth-blue-title">
            <div class="synth-choice-header synth-choice-header--blue">
              <div>
                <p>BLUE · CHOOSE A HEADING</p>
                <span>“Built for the long run” is locked.</span>
              </div>
              <div class="candidate-switcher" role="tablist" aria-label="Blue heading choices">
                {synthBlueHeadings.map((candidate, index) => (
                  <button
                    class:list={['candidate-tab', { 'is-active': index === 0 }]}
                    type="button"
                    role="tab"
                    aria-selected={index === 0 ? 'true' : 'false'}
                    data-synth-blue-target={candidate.id}
                  >{candidate.id}</button>
                ))}
              </div>
            </div>
            <p class="synth-blue-kicker">Built for the long run</p>
            <div class="synth-heading-stack synth-heading-stack--blue">
              {synthBlueHeadings.map((candidate, index) => (
                <h3 id={index === 0 ? 'synth-blue-title' : undefined} data-synth-blue={candidate.id} hidden={index !== 0}>{candidate.text}</h3>
              ))}
            </div>
            <p>We keep building and improving the systems with you, making AI part of how the whole business works—not another tool sitting off to the side.</p>
          </section>
        </article>
        <p class="response-cue">Choose one yellow letter and one blue letter—or reject either set. The hero is already locked from your feedback.</p>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const rounds = [...document.querySelectorAll('[data-round]')];
    const roundTabs = [...document.querySelectorAll('[data-round-target]')];
    const showRound = (name) => {
      rounds.forEach((round) => {
        const active = round.dataset.round === name;
        round.hidden = !active;
        round.classList.toggle('is-active', active);
      });
      roundTabs.forEach((tab) => {
        const active = tab.dataset.roundTarget === name;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
    };
    roundTabs.forEach((tab) => tab.addEventListener('click', () => showRound(tab.dataset.roundTarget)));

    document.querySelectorAll('[data-candidate-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.candidateTarget;
      document.querySelectorAll('[data-candidate]').forEach((candidate) => {
        const active = candidate.dataset.candidate === id;
        candidate.hidden = !active;
        candidate.classList.toggle('is-active', active);
      });
      document.querySelectorAll('[data-candidate-target]').forEach((button) => {
        const active = button.dataset.candidateTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      history.replaceState(null, '', `#visual-${id.toLowerCase()}`);
    }));

    document.querySelectorAll('[data-copy-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.copyTarget;
      document.querySelectorAll('[data-copy]').forEach((candidate) => {
        const active = candidate.dataset.copy === id;
        candidate.hidden = !active;
        candidate.classList.toggle('is-active', active);
      });
      document.querySelectorAll('[data-copy-target]').forEach((button) => {
        const active = button.dataset.copyTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      history.replaceState(null, '', `#copy-${id.toLowerCase()}`);
    }));

    document.querySelectorAll('[data-refine-hero-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.refineHeroTarget;
      document.querySelectorAll('[data-refine-hero]').forEach((candidate) => {
        const active = candidate.dataset.refineHero === id;
        candidate.hidden = !active;
        candidate.classList.toggle('is-active', active);
      });
      document.querySelectorAll('[data-refine-hero-target]').forEach((button) => {
        const active = button.dataset.refineHeroTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      history.replaceState(null, '', `#refine-hero-${id.toLowerCase()}`);
    }));

    document.querySelectorAll('[data-refine-blue-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.refineBlueTarget;
      document.querySelectorAll('[data-refine-blue]').forEach((candidate) => {
        const active = candidate.dataset.refineBlue === id;
        candidate.hidden = !active;
        candidate.classList.toggle('is-active', active);
      });
      document.querySelectorAll('[data-refine-blue-target]').forEach((button) => {
        const active = button.dataset.refineBlueTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      history.replaceState(null, '', `#refine-blue-${id.toLowerCase()}`);
    }));

    document.querySelectorAll('[data-reset-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.resetTarget;
      document.querySelectorAll('[data-reset]').forEach((candidate) => {
        const active = candidate.dataset.reset === id;
        candidate.hidden = !active;
        candidate.classList.toggle('is-active', active);
      });
      document.querySelectorAll('[data-reset-target]').forEach((button) => {
        const active = button.dataset.resetTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      history.replaceState(null, '', `#reset-${id.toLowerCase()}`);
    }));

    const updateSynthHash = () => {
      const yellow = document.querySelector('[data-synth-yellow]:not([hidden])')?.dataset.synthYellow?.toLowerCase() || 'a';
      const blue = document.querySelector('[data-synth-blue]:not([hidden])')?.dataset.synthBlue?.toLowerCase() || 'a';
      history.replaceState(null, '', `#synth-${yellow}-${blue}`);
    };

    document.querySelectorAll('[data-synth-yellow-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.synthYellowTarget;
      document.querySelectorAll('[data-synth-yellow]').forEach((candidate) => {
        candidate.hidden = candidate.dataset.synthYellow !== id;
      });
      document.querySelectorAll('[data-synth-yellow-target]').forEach((button) => {
        const active = button.dataset.synthYellowTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      updateSynthHash();
    }));

    document.querySelectorAll('[data-synth-blue-target]').forEach((tab) => tab.addEventListener('click', () => {
      const id = tab.dataset.synthBlueTarget;
      document.querySelectorAll('[data-synth-blue]').forEach((candidate) => {
        candidate.hidden = candidate.dataset.synthBlue !== id;
      });
      document.querySelectorAll('[data-synth-blue-target]').forEach((button) => {
        const active = button.dataset.synthBlueTarget === id;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-selected', String(active));
      });
      updateSynthHash();
    }));

    const refineMatch = location.hash.match(/^#refine-(hero|blue)-([a-c])$/i);
    const resetMatch = location.hash.match(/^#reset-([a-c])$/i);
    const synthMatch = location.hash.match(/^#synth-([a-c])-([a-c])$/i);
    const match = location.hash.match(/^#(visual|copy)-([a-d])$/i);
    if (synthMatch) {
      showRound('synth');
      [...document.querySelectorAll('[data-synth-yellow-target]')].find((button) => button.textContent.trim().toLowerCase() === synthMatch[1].toLowerCase())?.click();
      [...document.querySelectorAll('[data-synth-blue-target]')].find((button) => button.textContent.trim().toLowerCase() === synthMatch[2].toLowerCase())?.click();
    } else if (resetMatch) {
      showRound('reset');
      [...document.querySelectorAll('[data-reset-target]')].find((button) => button.textContent.trim().toLowerCase() === resetMatch[1].toLowerCase())?.click();
    } else if (refineMatch) {
      showRound('refine');
      const selector = refineMatch[1].toLowerCase() === 'hero' ? '[data-refine-hero-target]' : '[data-refine-blue-target]';
      [...document.querySelectorAll(selector)].find((button) => button.textContent.trim().toLowerCase() === refineMatch[2].toLowerCase())?.click();
    } else if (match) {
      showRound(match[1].toLowerCase());
      const selector = match[1].toLowerCase() === 'visual' ? '[data-candidate-target]' : '[data-copy-target]';
      [...document.querySelectorAll(selector)].find((button) => button.textContent.trim().toLowerCase() === match[2].toLowerCase())?.click();
    }
  })();
</script>

