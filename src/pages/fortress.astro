---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Own Your AI Fortress — Buildwise Media';
const description = 'Own the code, data, customer list, and ad accounts behind your AI engine. Keep the asset and the freedom to leave.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://buildwisemedia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Fortress', item: 'https://buildwisemedia.com/fortress' },
  ],
};
---
<BaseLayout title={title} description={description} jsonLd={breadcrumb}>
  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">The Fortress · Ownership is the strategy</p>
          <h1>Do not build a growing business inside a rented house.</h1>
          <p class="deck">Most agencies build you a rented house on someone else's land. We build you a fortress on your own soil. The engine grows. You keep the ground under it.</p>
          <div class="ctas">
            <a class="cta" href="/revenue-leak-map" data-cta-source="fortress-page-hero-primary">Get My Free Revenue Leak Map <span aria-hidden="true">→</span></a>
            <a class="cta-ghost" href="/book" data-cta-source="fortress-page-hero-secondary">See If We're a Fit</a>
          </div>
          <p class="qual mono">For established service businesses with real revenue. Owners looking for a savior bounce off — and that is the right outcome.</p>
        </div>
        <aside class="claim-card">
          <span class="label">Available now</span>
          <p class="mono">CLIENT-OWNED AI OPERATING INFRASTRUCTURE</p>
          <strong>Revenue is the first use case. Ownership is the long game.</strong>
        </aside>
      </div>
    </section>

    <section class="compare elev">
      <div class="container">
        <p class="section-tag">The ownership test</p>
        <h2>Ask five questions before the work begins.</h2>
        <p class="lede">Terms differ. Read the contract. Then ask what remains yours if the relationship ends.</p>
        <div class="table" role="table" aria-label="Rented setup compared with the Buildwise fortress">
          <div class="row head" role="row"><span>WHAT TO TEST</span><span>RENTED HOUSE</span><span>YOUR FORTRESS</span></div>
          <div class="row"><strong>Code</strong><span>May only work inside the provider's setup.</span><span>You own the custom code we deliver.</span></div>
          <div class="row"><strong>Data + customer list</strong><span>Exports and access may depend on the contract.</span><span>Your business keeps its data and customer list.</span></div>
          <div class="row"><strong>Ad accounts</strong><span>Control may sit outside your business.</span><span>Your business owns and controls the accounts.</span></div>
          <div class="row"><strong>The day you leave</strong><span>The working system may vanish with access.</span><span>You keep the installed engine and delivered assets.</span></div>
          <div class="row"><strong>Terms</strong><span>A long lock can hide weak work.</span><span>True month-to-month after day 90.</span></div>
        </div>
      </div>
    </section>

    <section class="paths-section">
      <div class="container">
        <p class="section-tag">Two paths</p>
        <div class="paths">
          <article><span class="num mono">01 · KEEP RENTING</span><h2>Each gain stays tied to a gatekeeper.</h2><p>New tools create new handoffs. The owner stays the router. Leaving can mean starting over with the system, its history, or both.</p></article>
          <article class="owned"><span class="num mono">02 · BUILD THE FORTRESS</span><h2>Each weekly build becomes a business asset.</h2><p>We are the dedicated engineering team that builds, maintains, and secures an engine the client owns. Security is engineered, tested, and monitored. High-stakes decisions get quality review appropriate to the work.</p></article>
        </div>
        <div class="trust"><strong>Targets defined in the work order</strong><span>Baseline and measurement rules visible</span><strong>True month-to-month after day 90</strong><span>You keep the option to leave</span></div>
        <div class="final">
          <div><h2>Build on your soil. Keep what gets built.</h2><p class="lede">The weekly engine should make your business less dependent, not more.</p></div>
          <div class="ctas"><a class="cta" href="/revenue-leak-map" data-cta-source="fortress-page-final-primary">Get My Free Revenue Leak Map <span aria-hidden="true">→</span></a><a class="cta-ghost" href="/book" data-cta-source="fortress-page-final-secondary">See If We're a Fit</a></div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.hero{padding:clamp(96px,11vw,160px) 0 80px}.hero-grid{display:grid;gap:48px;align-items:center}.hero h1{font-size:clamp(42px,7vw,76px);line-height:1;letter-spacing:-.045em}.deck{font-size:clamp(20px,2.5vw,27px);line-height:1.45;color:var(--ink-dim);max-width:760px}.ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.qual{font-size:11px;color:var(--ink-faint);line-height:1.6;max-width:660px}.claim-card{border:1px solid var(--rule);padding:32px;background:var(--bg-card)}.claim-card p{font-size:10px;color:var(--ink-faint);margin:24px 0 12px}.claim-card strong{font-size:24px;line-height:1.35}.compare,.paths-section{padding:clamp(64px,8vw,112px) 0;border-top:1px solid var(--rule)}h2{font-size:clamp(30px,4.5vw,52px);line-height:1.08;letter-spacing:-.03em;margin:20px 0}.lede,.paths p{color:var(--ink-dim);font-size:18px;line-height:1.65}.table{margin-top:40px;border:1px solid var(--rule)}.row{display:grid;grid-template-columns:1fr;padding:20px;border-bottom:1px solid var(--rule);gap:10px}.row:last-child{border:0}.row span{color:var(--ink-dim);line-height:1.5}.row span:last-child{color:var(--ink)}.head{font:700 10px var(--mono);letter-spacing:.1em;color:var(--y2)}.paths{display:grid;gap:1px;background:var(--rule);margin-top:36px}.paths article{background:var(--bg);padding:clamp(28px,4vw,48px)}.paths .owned{box-shadow:inset 3px 0 var(--y2)}.num{color:var(--y2);font-size:11px}.trust{display:grid;grid-template-columns:auto 1fr;gap:8px 20px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);padding:28px 0;margin-top:50px}.trust strong{color:var(--y2)}.trust span{color:var(--ink-dim)}.final{margin-top:64px;display:flex;align-items:center;justify-content:space-between;gap:32px;flex-wrap:wrap}@media(min-width:900px){.hero-grid{grid-template-columns:1.2fr .8fr}.row{grid-template-columns:.7fr 1fr 1fr}.paths{grid-template-columns:1fr 1fr}}
</style>
