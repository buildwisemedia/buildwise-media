---
// @build-author-exempt: Sol dispatch attempted (bwm-codex, 2026-07-20) and hung 54 min with zero
// output — killed; authored inline as the documented exception path with Robert waiting live.
// Card-scan landing page for the printed public card QR. Hrefs are press-adjacent contract values.
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Connect with Robert — Buildwise Media';
const description = 'You have my card. Save my contact, book 30 minutes, or connect on LinkedIn.';
---
<BaseLayout title={title} description={description} noindex={true}>
  <!-- @r020-exempt: card-scan utility page — three action buttons, no imagery surface -->
  <section class="connect-page">
    <div class="container connect-shell">
      <p class="eyebrow mono">YOU'VE GOT MY CARD</p>
      <h1 class="connect-title">Good meeting you.</h1>
      <p class="connect-sub">Three ways to keep this going — pick whichever is easiest.</p>

      <div class="connect-actions">
        <a class="ca ca-primary" href="/robert-echevarria.vcf" data-action="vcard">
          Save my contact
        </a>
        <a class="ca" href="https://book.buildwisemedia.com/bwm/30-min" data-action="book">
          Book 30 minutes with me
        </a>
        <a class="ca" href="https://www.linkedin.com/in/robertechevarria/" target="_blank" rel="noopener" data-action="linkedin">
          Connect on LinkedIn
        </a>
      </div>

      <p class="connect-second">
        Want to see what your business is leaking first?
        Get your free <a href="/revenue-leak-map" data-action="leakmap">Revenue Leak Map</a>.
      </p>

      <p class="connect-foot mono">BUILDWISE MEDIA &middot; ATLANTA</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('[data-action]') : null;
    if (!el) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'card_connect_action', action: el.getAttribute('data-action') });
  });

  // Android: hand the contact file to the system share sheet (Contacts opens it
  // directly) instead of routing through the browser's download pipeline.
  // iOS Safari already opens text/vcard natively on navigation — leave it alone.
  (function () {
    var isAndroid = /Android/i.test(navigator.userAgent);
    if (!isAndroid || !navigator.canShare) return;
    var link = document.querySelector('[data-action="vcard"]');
    if (!link) return;
    link.addEventListener('click', function (e) {
      e.preventDefault();
      fetch(link.href)
        .then(function (r) { return r.blob(); })
        .then(function (b) {
          var f = new File([b], 'robert-echevarria.vcf', { type: 'text/vcard' });
          if (navigator.canShare({ files: [f] })) return navigator.share({ files: [f] });
          window.location.href = link.href;
        })
        .catch(function () { window.location.href = link.href; });
    });
  })();
</script>

<style>
  .connect-page { min-height: 72vh; display: flex; align-items: center; padding: 48px 0 64px; }
  .connect-shell { max-width: 460px; }
  .connect-title { font-size: clamp(34px, 9vw, 44px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; margin: 10px 0 10px; }
  .connect-sub { font-size: 16px; color: var(--ink-soft, #9DA0A8); margin: 0 0 26px; }
  .connect-actions { display: flex; flex-direction: column; gap: 12px; }
  .ca {
    display: flex; align-items: center; justify-content: center;
    min-height: 58px; padding: 14px 18px;
    border: 1px solid var(--hairline, #2A2A33); border-radius: 8px;
    font-size: 16px; font-weight: 600; text-decoration: none;
    color: var(--ink, #ECECEC); background: transparent;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .ca:hover, .ca:focus-visible { border-color: var(--y2, #F0FF00); }
  .ca:focus-visible { outline: 2px solid var(--y2, #F0FF00); outline-offset: 2px; }
  .ca-primary { background: var(--y2, #F0FF00); color: #050507; border-color: var(--y2, #F0FF00); }
  .ca-primary:hover { background: #E2F000; }
  .connect-second { font-size: 13.5px; color: var(--ink-soft, #9DA0A8); margin: 22px 0 0; }
  .connect-second a { color: var(--y2, #F0FF00); }
  .connect-foot { font-size: 10px; letter-spacing: 0.18em; color: var(--ink-faint, #6E7280); margin-top: 40px; }
</style>
