# Cloudflare Pages headers — security + long-cache for fingerprinted assets.
# Indexing/X-Robots-Tag intentionally NOT set here: the custom domain is
# indexable by default and *.pages.dev is auto-noindexed by Cloudflare.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Content-Signals: search=yes, ai-input=yes, ai-train=yes

# Astro fingerprints filenames under /assets, so they are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Contact card behind the printed business card's QR (/connect). Served inline
# as text/vcard so tapping "Save my contact" opens the phone's native
# add-contact sheet instead of downloading a file.
/robert-echevarria.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: inline; filename="robert-echevarria.vcf"
  Cache-Control: public, max-age=300

# Self-hosted brand fonts. Filenames carry a -vN version suffix (see
# src/styles/global.css @font-face + BaseLayout preloads), so they are
# immutable: bump the suffix to ship new bytes rather than overwriting in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
